@{
    ViewData["Title"] = @"Customer Details | CrediTrack";
    ViewData["Body"] = @"class=""owner"" data-root=""/"" data-page=""customers"" data-nav=""sub"" data-title=""Customer Details"" data-back=""customers""";
}

@section Head {
  <meta name="description" content="A customer's information, outstanding balance, and credit and payment history.">
  <meta name="theme-color" content="#071A52">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/tokens.css?v=2">
  <link rel="stylesheet" href="/css/base.css?v=2">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/components/owner-shell.css?v=3">
  <link rel="stylesheet" href="/css/components/owner-ui.css?v=2">
  <link rel="stylesheet" href="/css/components/record-utang.css?v=date2">
  <link rel="stylesheet" href="/css/components/record-bayad.css">
  <link rel="stylesheet" href="/css/components/link-account.css?v=2">
  <link rel="stylesheet" href="/css/pages/owner-customers.css?v=5">
  <link rel="stylesheet" href="/css/components/breadcrumbs.css">
  <link rel="stylesheet" href="/css/glass.css?v=4">
  <link rel="stylesheet" href="/css/polish.css?v=1">
}

  <div class="owner-app">
    <!-- Header, sidebar and bottom navigation are added here by js/components/owner-shell.js -->
    <main class="owner-main" id="main">
      <div class="page" id="page">



        <!-- Shown when the link has no valid customer -->
        <section class="panel" id="missing" hidden>
          <div class="empty">
            <span class="empty__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4.5 21a7.5 7.5 0 0 1 15 0"/></svg></span>
            <h2 class="empty__title">Customer not found</h2>
            <p class="empty__text">This customer may have been removed, or the link is incorrect.</p>
            <a class="btn btn--primary" href="customers" data-route="owner-customers">Back to Customers</a>
          </div>
        </section>

        <div class="detail" id="detail" hidden>
          <div class="detail__col">

            <!-- Shown only for an archived customer -->
            <div class="notice notice--archived" id="archived-note" hidden>
              <p><strong>This customer is archived<span id="archived-when"></span>.</strong> Their transactions, payments and balance are kept. Restore the customer to record new utang. Payments can still be recorded.</p>
            </div>

            <section class="panel profile" aria-labelledby="cust-name">
              <span class="profile__avatar" id="cust-avatar" aria-hidden="true"></span>
              <div class="profile__main">
                <h2 class="profile__name" id="cust-name"></h2>
                <p class="profile__code" id="cust-code"></p>
                <span class="badge" id="cust-status"></span>
              </div>
              <a class="btn btn--secondary profile__edit" href="customer-form" id="edit-open" aria-label="Edit customer information">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20h4L19 9a2.1 2.1 0 0 0-4-4L4 16z"/><path d="M13.5 6.5l4 4"/></svg>
                <span>Edit</span>
              </a>
            </section>

            <section class="balance" aria-labelledby="balance-title">
              <h2 class="balance__label" id="balance-title">Outstanding Balance</h2>
              <p class="balance__amount" id="cust-balance">&#8369;0.00</p>
              <p class="balance__note" id="cust-overdue" hidden></p>
              <dl class="balance__split">
                <div><dt>Total Credit</dt><dd id="cust-credit">&#8369;0.00</dd></div>
                <div><dt>Total Payments</dt><dd id="cust-paid">&#8369;0.00</dd></div>
              </dl>
            </section>

            <div class="actions">
              <a class="btn btn--navy" href="#" data-route="record-credit"><span data-icon="credit"></span>Record Utang</a>
              <a class="btn btn--primary" href="#" data-route="record-payment"><span data-icon="payment"></span>Record Bayad</a>
            </div>

            <!-- Customer Account: the customer's CrediTrack account, linked to this record (js/components/link-account.js) -->
            <section class="panel account" id="account" aria-labelledby="account-title">
              <div class="account__head">
                <span class="account__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4.5 21a7.5 7.5 0 0 1 15 0"/></svg></span>
                <div class="account__main">
                  <h2 class="account__title" id="account-title">Customer Account</h2>
                  <p class="account__text" id="account-text">This customer has not linked their CrediTrack account yet.</p>
                </div>
              </div>
              <button class="btn btn--secondary btn--block account__link" type="button" id="account-link">Link Customer Account</button>
              <button class="btn btn--ghost btn--block account__link" type="button" id="account-cancel" hidden>Cancel Link Request</button>
              <dl class="info__list account__info" id="account-info" hidden>
                <div><dt>Account Name</dt><dd id="account-name"></dd></div>
                <div><dt>Account ID</dt><dd id="account-id"></dd></div>
                <div id="account-email-row"><dt>Email</dt><dd id="account-email"></dd></div>
                <div id="account-phone-row"><dt>Mobile Number</dt><dd id="account-phone"></dd></div>
                <div><dt>Linked On</dt><dd id="account-linked"></dd></div>
                <div><dt>Connection Status</dt><dd><span class="badge" id="account-status"></span></dd></div>
              </dl>
            </section>

            <section class="panel info" aria-labelledby="info-title">
              <div class="panel__head"><h2 class="panel__title" id="info-title">Customer Information</h2></div>
              <dl class="info__list">
                <div><dt>Full Name</dt><dd id="info-name"></dd></div>
                <div><dt>Contact Number</dt><dd id="info-phone"></dd></div>
                <div><dt>Customer ID</dt><dd id="info-code"></dd></div>
                <div><dt>Customer Since</dt><dd id="info-since"></dd></div>
              </dl>
              <div class="archive-box">
                <p class="archive-box__text" id="archive-text"></p>
                <button class="btn btn--secondary btn--block" type="button" id="archive-btn"></button>
              </div>
            </section>
          </div>

          <div class="detail__col">
            <section class="panel history" aria-labelledby="history-title">
              <div class="panel__head"><h2 class="panel__title" id="history-title">Recent Transactions</h2></div>
              <div class="chips" role="group" aria-label="Filter transactions" id="history-chips">
                <button class="chip" type="button" data-filter="all" aria-pressed="true">All</button>
                <button class="chip" type="button" data-filter="credit" aria-pressed="false">Credits</button>
                <button class="chip" type="button" data-filter="payment" aria-pressed="false">Payments</button>
              </div>
              <ul class="list history__list" id="history-list" hidden></ul>
              <a class="btn btn--secondary btn--block history__all" id="history-all" href="transactions" hidden>View all transactions</a>
              <div class="empty" id="history-empty" hidden>
                <span class="empty__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h14l-3.5-3.5M20 16H6l3.5 3.5"/></svg></span>
                <h3 class="empty__title" id="history-empty-title">No transactions yet</h3>
                <p class="empty__text" id="history-empty-text">Credit and payments recorded for this customer will show up here.</p>
              </div>
            </section>
          </div>
        </div>

      </div>
    </main>
  </div>

  <!-- Archive / Restore confirmation -->
  <div class="confirm" id="archive-confirm" role="alertdialog" aria-modal="true" aria-labelledby="archive-confirm-title" aria-describedby="archive-confirm-text" hidden>
    <div class="confirm__card">
      <h2 class="confirm__title" id="archive-confirm-title"></h2>
      <p class="confirm__text" id="archive-confirm-text"></p>
      <div class="confirm__actions">
        <button class="btn btn--primary" type="button" id="archive-confirm-yes"></button>
        <button class="btn btn--secondary" type="button" id="archive-confirm-no">Cancel</button>
      </div>
    </div>
  </div>

  <div class="toast" id="toast" role="status" aria-live="polite"></div>

@section Scripts {
  <script src="/js/session.js?v=5"></script>
  <script src="/js/api/http.js"></script>
  <script src="/js/api/owner-api.js"></script>
  <script src="/js/components/owner-shell.js"></script>
  <script src="/js/components/breadcrumbs.js"></script>
  <script src="/js/main.js"></script>
  <script src="/js/components/record-utang.js"></script>
  <script src="/js/components/record-bayad.js"></script>
  <script src="/js/vendor/jsqr.js"></script>
  <script src="/js/components/link-account.js?v=2"></script>
  <script src="/js/pages/owner-customer-details.js?v=p6"></script>
}
