@{
    ViewData["Title"] = @"Store Information | CrediTrack";
    ViewData["Body"] = @"class=""owner"" data-root=""/"" data-page=""settings"" data-nav=""sub"" data-title=""Store Information"" data-back=""settings""";
}

@section Head {
  <meta name="description" content="Your store name, address, contact number and other store details.">
  <meta name="theme-color" content="#071A52">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/tokens.css?v=2">
  <link rel="stylesheet" href="/css/base.css?v=2">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/components/owner-shell.css?v=3">
  <link rel="stylesheet" href="/css/components/owner-ui.css?v=2">
  <!-- Shared owner page styles (page grid, heading, profile card, info list, form actions): same look as Customers -->
  <link rel="stylesheet" href="/css/pages/owner-customers.css">
  <link rel="stylesheet" href="/css/pages/owner-settings.css?v=4">
  <link rel="stylesheet" href="/css/components/breadcrumbs.css">
  <link rel="stylesheet" href="/css/glass.css?v=4">
  <link rel="stylesheet" href="/css/polish.css?v=1">
}

  <div class="owner-app">
    <!-- Back button and title are added here by js/components/owner-shell.js -->
    <main class="owner-main" id="main">
      <div class="page page--settings page--settings-sub" id="page">


        <!-- View -->
        <div class="st-stack" id="store-view">
          <section class="panel" aria-labelledby="store-title">
            <div class="panel__head">
              <h2 class="panel__title" id="store-title">Store Information</h2>
              <button class="btn btn--secondary st-edit-btn" type="button" id="store-edit-open" aria-controls="store-form">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20h4L19 9a2.1 2.1 0 0 0-4-4L4 16z"/><path d="M13.5 6.5l4 4"/></svg>
                <span>Edit</span>
              </button>
            </div>
            <dl class="info__list">
              <div><dt>Store Name</dt><dd id="pf-storeName"></dd></div>
              <div><dt>Store Contact Number</dt><dd id="pf-storePhone"></dd></div>
              <div><dt>Business Type</dt><dd id="pf-businessType"></dd></div>
              <div><dt>Store Hours</dt><dd id="pf-storeHours"></dd></div>
              <div class="info__row--stack"><dt>Store Address</dt><dd id="pf-storeAddress"></dd></div>
              <div><dt>Store Code</dt><dd id="pf-storeCode"></dd></div>
            </dl>
          </section>

          <!-- Payment Accounts: the GCash / Maya / Bank details and QR picture customers see when they pay (one account per method).
               CrediTrack only records payments, it never moves money. Logic: js/pages/owner-store-info.js -->
          <section class="panel pa" id="pa-section" aria-labelledby="pa-title">
            <div class="panel__head">
              <h2 class="panel__title" id="pa-title">Payment Accounts</h2>
            </div>
            <p class="st-intro">Save your GCash, Maya or bank details so customers can see where to send their payments. CrediTrack only records payments. It never moves money.</p>
            <p class="field__hint" id="pa-loading" role="status">Loading payment accounts&hellip;</p>
            <div class="pa-load-error" id="pa-load-error" hidden>
              <p class="field__error" role="alert">We couldn&rsquo;t load your payment accounts.</p>
              <button class="btn btn--secondary pa-btn" type="button" id="pa-retry">Try Again</button>
            </div>
            <div class="pa-body" id="pa-body" hidden>
              <div class="pa-tabs" role="tablist" aria-label="Payment method" id="pa-tablist">
            <button class="pa-tab" type="button" role="tab" id="pa-tab-gcash" data-method="gcash" aria-selected="true" aria-controls="pa-panel-gcash" tabindex="0"><span>GCash</span><span class="pa-tab__dot" id="pa-dot-gcash" hidden><span class="visually-hidden"> (set up)</span></span></button>
            <button class="pa-tab" type="button" role="tab" id="pa-tab-maya" data-method="maya" aria-selected="false" aria-controls="pa-panel-maya" tabindex="-1"><span>Maya</span><span class="pa-tab__dot" id="pa-dot-maya" hidden><span class="visually-hidden"> (set up)</span></span></button>
            <button class="pa-tab" type="button" role="tab" id="pa-tab-bank" data-method="bank" aria-selected="false" aria-controls="pa-panel-bank" tabindex="-1"><span>Bank</span><span class="pa-tab__dot" id="pa-dot-bank" hidden><span class="visually-hidden"> (set up)</span></span></button>
              </div>
          <div class="pa-panel" role="tabpanel" id="pa-panel-gcash" aria-labelledby="pa-tab-gcash">
            <form class="pa-form" id="pa-form-gcash" novalidate aria-label="GCash account">
              <p class="pa-status-row"><span class="badge pa-status" id="pa-status-gcash">Not set up yet</span></p>
              <div class="st-fields">
                <div class="field">
                  <label class="field__label" for="pa-name-gcash">Account name <span aria-hidden="true">*</span></label>
                  <input class="input" id="pa-name-gcash" type="text" autocomplete="off" maxlength="60" placeholder="e.g., Nena Santos" required aria-describedby="pa-name-gcash-error">
                  <p class="field__error" id="pa-name-gcash-error" hidden></p>
                </div>
                <div class="field">
                  <label class="field__label" for="pa-number-gcash">Account number <span aria-hidden="true">*</span></label>
                  <input class="input" id="pa-number-gcash" type="text" inputmode="tel" autocomplete="off" maxlength="30" placeholder="e.g., 0917 123 4567" required aria-describedby="pa-number-gcash-hint pa-number-gcash-error">
                  <p class="field__hint" id="pa-number-gcash-hint">Your GCash mobile number, like 0917 123 4567.</p>
                  <p class="field__error" id="pa-number-gcash-error" hidden></p>
                </div>
                <div class="field pa-qr">
                  <p class="field__label" id="pa-qr-label-gcash">QR code <span class="field__opt">(optional)</span></p>
                  <div class="pa-qr__box">
                    <div class="pa-qr__frame">
                      <img class="pa-qr__img" id="pa-qr-img-gcash" alt="GCash QR code preview" hidden>
                      <span class="pa-qr__empty" id="pa-qr-empty-gcash">No QR picture yet</span>
                    </div>
                    <div class="pa-qr__side">
                      <div class="pa-qr__actions">
                        <label class="btn btn--secondary pa-btn" for="pa-qr-gcash" id="pa-qr-pick-gcash">Upload QR</label>
                        <input class="visually-hidden" id="pa-qr-gcash" type="file" accept="image/jpeg,image/png,image/webp" aria-describedby="pa-qr-hint-gcash pa-qr-note-gcash pa-qr-gcash-error">
                        <button class="btn btn--ghost pa-btn" type="button" id="pa-qr-remove-gcash" hidden>Remove QR</button>
                      </div>
                      <p class="field__hint" id="pa-qr-hint-gcash">JPG, PNG or WebP. A picture of just the QR code scans best.</p>
                      <p class="field__hint pa-qr__note" id="pa-qr-note-gcash" hidden></p>
                      <p class="field__error" id="pa-qr-gcash-error" role="alert" hidden></p>
                    </div>
                  </div>
                </div>
              </div>
              <div class="pa-actions">
                <button class="btn btn--primary" type="submit" id="pa-save-gcash">Save</button>
                <button class="btn pa-remove" type="button" id="pa-remove-gcash" hidden>Remove account</button>
              </div>
            </form>
          </div>
          <div class="pa-panel" role="tabpanel" id="pa-panel-maya" aria-labelledby="pa-tab-maya" hidden>
            <form class="pa-form" id="pa-form-maya" novalidate aria-label="Maya account">
              <p class="pa-status-row"><span class="badge pa-status" id="pa-status-maya">Not set up yet</span></p>
              <div class="st-fields">
                <div class="field">
                  <label class="field__label" for="pa-name-maya">Account name <span aria-hidden="true">*</span></label>
                  <input class="input" id="pa-name-maya" type="text" autocomplete="off" maxlength="60" placeholder="e.g., Nena Santos" required aria-describedby="pa-name-maya-error">
                  <p class="field__error" id="pa-name-maya-error" hidden></p>
                </div>
                <div class="field">
                  <label class="field__label" for="pa-number-maya">Account number <span aria-hidden="true">*</span></label>
                  <input class="input" id="pa-number-maya" type="text" inputmode="tel" autocomplete="off" maxlength="30" placeholder="e.g., 0917 123 4567" required aria-describedby="pa-number-maya-hint pa-number-maya-error">
                  <p class="field__hint" id="pa-number-maya-hint">Your Maya mobile number, like 0917 123 4567.</p>
                  <p class="field__error" id="pa-number-maya-error" hidden></p>
                </div>
                <div class="field pa-qr">
                  <p class="field__label" id="pa-qr-label-maya">QR code <span class="field__opt">(optional)</span></p>
                  <div class="pa-qr__box">
                    <div class="pa-qr__frame">
                      <img class="pa-qr__img" id="pa-qr-img-maya" alt="Maya QR code preview" hidden>
                      <span class="pa-qr__empty" id="pa-qr-empty-maya">No QR picture yet</span>
                    </div>
                    <div class="pa-qr__side">
                      <div class="pa-qr__actions">
                        <label class="btn btn--secondary pa-btn" for="pa-qr-maya" id="pa-qr-pick-maya">Upload QR</label>
                        <input class="visually-hidden" id="pa-qr-maya" type="file" accept="image/jpeg,image/png,image/webp" aria-describedby="pa-qr-hint-maya pa-qr-note-maya pa-qr-maya-error">
                        <button class="btn btn--ghost pa-btn" type="button" id="pa-qr-remove-maya" hidden>Remove QR</button>
                      </div>
                      <p class="field__hint" id="pa-qr-hint-maya">JPG, PNG or WebP. A picture of just the QR code scans best.</p>
                      <p class="field__hint pa-qr__note" id="pa-qr-note-maya" hidden></p>
                      <p class="field__error" id="pa-qr-maya-error" role="alert" hidden></p>
                    </div>
                  </div>
                </div>
              </div>
              <div class="pa-actions">
                <button class="btn btn--primary" type="submit" id="pa-save-maya">Save</button>
                <button class="btn pa-remove" type="button" id="pa-remove-maya" hidden>Remove account</button>
              </div>
            </form>
          </div>
          <div class="pa-panel" role="tabpanel" id="pa-panel-bank" aria-labelledby="pa-tab-bank" hidden>
            <form class="pa-form" id="pa-form-bank" novalidate aria-label="Bank account">
              <p class="pa-status-row"><span class="badge pa-status" id="pa-status-bank">Not set up yet</span></p>
              <div class="st-fields">
                <div class="field">
                  <label class="field__label" for="pa-name-bank">Account name <span aria-hidden="true">*</span></label>
                  <input class="input" id="pa-name-bank" type="text" autocomplete="off" maxlength="60" placeholder="e.g., Nena Santos" required aria-describedby="pa-name-bank-error">
                  <p class="field__error" id="pa-name-bank-error" hidden></p>
                </div>
                <div class="field">
                  <label class="field__label" for="pa-bank-bank">Bank name <span aria-hidden="true">*</span></label>
                  <input class="input" id="pa-bank-bank" type="text" autocomplete="off" maxlength="40" placeholder="e.g., BDO, BPI, Landbank" required aria-describedby="pa-bank-bank-error">
                  <p class="field__error" id="pa-bank-bank-error" hidden></p>
                </div>
                <div class="field">
                  <label class="field__label" for="pa-number-bank">Account number <span aria-hidden="true">*</span></label>
                  <input class="input" id="pa-number-bank" type="text" inputmode="tel" autocomplete="off" maxlength="30" placeholder="e.g., 0917 123 4567" required aria-describedby="pa-number-bank-hint pa-number-bank-error">
                  <p class="field__hint" id="pa-number-bank-hint">Your bank account number (7 to 20 digits).</p>
                  <p class="field__error" id="pa-number-bank-error" hidden></p>
                </div>
                <div class="field pa-qr">
                  <p class="field__label" id="pa-qr-label-bank">QR code <span class="field__opt">(optional)</span></p>
                  <div class="pa-qr__box">
                    <div class="pa-qr__frame">
                      <img class="pa-qr__img" id="pa-qr-img-bank" alt="Bank QR code preview" hidden>
                      <span class="pa-qr__empty" id="pa-qr-empty-bank">No QR picture yet</span>
                    </div>
                    <div class="pa-qr__side">
                      <div class="pa-qr__actions">
                        <label class="btn btn--secondary pa-btn" for="pa-qr-bank" id="pa-qr-pick-bank">Upload QR</label>
                        <input class="visually-hidden" id="pa-qr-bank" type="file" accept="image/jpeg,image/png,image/webp" aria-describedby="pa-qr-hint-bank pa-qr-note-bank pa-qr-bank-error">
                        <button class="btn btn--ghost pa-btn" type="button" id="pa-qr-remove-bank" hidden>Remove QR</button>
                      </div>
                      <p class="field__hint" id="pa-qr-hint-bank">JPG, PNG or WebP. A picture of just the QR code scans best.</p>
                      <p class="field__hint pa-qr__note" id="pa-qr-note-bank" hidden></p>
                      <p class="field__error" id="pa-qr-bank-error" role="alert" hidden></p>
                    </div>
                  </div>
                </div>
              </div>
              <div class="pa-actions">
                <button class="btn btn--primary" type="submit" id="pa-save-bank">Save</button>
                <button class="btn pa-remove" type="button" id="pa-remove-bank" hidden>Remove account</button>
              </div>
            </form>
          </div>
            </div>
          </section>
        </div>

        <!-- Edit mode: replaces the view above until Save Changes or Cancel -->
        <form class="panel form-panel st-form" id="store-form" novalidate hidden aria-labelledby="store-form-title">
          <div class="panel__head"><h2 class="panel__title" id="store-form-title">Edit Store Information</h2></div>
          <p class="form-panel__intro">Update your store details. Fields marked <span aria-hidden="true">*</span><span class="visually-hidden">with an asterisk</span> are required.</p>
          <div class="st-fields">
              <div class="field">
                <label class="field__label" for="sf-storeName">Store Name <span aria-hidden="true">*</span></label>
                <input class="input" id="sf-storeName" type="text" autocomplete="organization" maxlength="60" placeholder="e.g., Aling Nena's Store" required aria-describedby="sf-storeName-error">
                <p class="field__error" id="sf-storeName-error" hidden></p>
              </div>
              <div class="field">
                <label class="field__label" for="sf-storePhone">Store Contact Number <span aria-hidden="true">*</span></label>
                <input class="input" id="sf-storePhone" type="tel" inputmode="tel" autocomplete="off" maxlength="16" placeholder="09XX XXX XXXX" required aria-describedby="sf-storePhone-error">
                <p class="field__error" id="sf-storePhone-error" hidden></p>
              </div>
              <div class="field">
                <label class="field__label" for="sf-businessType">Business Type <span class="field__opt">(optional)</span></label>
                <select class="select" id="sf-businessType" aria-describedby="sf-businessType-error"><option value="">Select business type</option></select>
                <p class="field__error" id="sf-businessType-error" hidden></p>
              </div>
              <div class="field">
                <label class="field__label" for="sf-storeHours">Store Hours <span class="field__opt">(optional)</span></label>
                <input class="input" id="sf-storeHours" type="text" maxlength="60" placeholder="e.g., Mon-Sat, 6:00 AM - 9:00 PM" aria-describedby="sf-storeHours-hint sf-storeHours-error">
                <p class="field__hint" id="sf-storeHours-hint">Shown to you only for now.</p>
                <p class="field__error" id="sf-storeHours-error" hidden></p>
              </div>
              <div class="field">
                <label class="field__label" for="sf-storeAddress">Store Address <span aria-hidden="true">*</span></label>
                <textarea class="textarea" id="sf-storeAddress" rows="3" maxlength="160" autocomplete="street-address" placeholder="Street, Barangay, City / Municipality, Province" required aria-describedby="sf-storeAddress-hint sf-storeAddress-error"></textarea>
                <p class="field__hint" id="sf-storeAddress-hint">Include the street, barangay, city or municipality, and province.</p>
                <p class="field__error" id="sf-storeAddress-error" hidden></p>
              </div>
          </div>
          <p class="form-note"><strong>Store Code</strong>Your store code <span id="sf-code">&mdash;</span> is fixed and can&rsquo;t be edited here.</p>
          <div class="form-actions">
            <button class="btn btn--secondary" type="button" id="store-cancel">Cancel</button>
            <button class="btn btn--primary" type="submit" id="store-save">Save Changes</button>
          </div>
        </form>
      </div>
    </main>
  </div>

  <div class="toast" id="toast" role="status" aria-live="polite"></div>

@section Scripts {
  <script src="/js/session.js?v=5"></script>
  <script src="/js/api/http.js"></script>
  <script src="/js/api/owner-api.js?v=2"></script>
  <script src="/js/components/owner-shell.js"></script>
  <script src="/js/components/breadcrumbs.js"></script>
  <script src="/js/main.js"></script>
  <script src="/js/pages/owner-store-info.js?v=3"></script>
}
