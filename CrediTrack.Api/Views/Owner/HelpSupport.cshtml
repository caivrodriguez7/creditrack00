@{
    ViewData["Title"] = @"Help &amp; Support | CrediTrack";
    ViewData["Body"] = @"class=""owner"" data-root=""/"" data-page=""settings"" data-nav=""sub"" data-title=""Help &amp; Support"" data-back=""settings""";
}

@section Head {
  <meta name="description" content="Answers to common questions and ways to contact support.">
  <meta name="theme-color" content="#071A52">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/tokens.css?v=2">
  <link rel="stylesheet" href="/css/base.css?v=2">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/components/owner-shell.css?v=3">
  <link rel="stylesheet" href="/css/components/owner-ui.css?v=2">
  <!-- Shared owner page styles (page grid, heading, profile card, info list, form actions): same look as Customers -->
  <link rel="stylesheet" href="/css/pages/owner-customers.css">
  <link rel="stylesheet" href="/css/pages/owner-settings.css">
  <link rel="stylesheet" href="/css/components/breadcrumbs.css">
  <link rel="stylesheet" href="/css/components/help-bot.css">
  <link rel="stylesheet" href="/css/glass.css?v=4">
  <link rel="stylesheet" href="/css/polish.css?v=1">
}

  <div class="owner-app">
    <!-- Back button and title are added here by js/components/owner-shell.js -->
    <main class="owner-main" id="main">
      <div class="page page--settings page--settings-sub" id="page">

        @await Html.PartialAsync("/Pages/Shared/_HelpBot.cshtml")

        <section class="panel" aria-labelledby="faq-title">
          <div class="panel__head"><h2 class="panel__title" id="faq-title">Frequently Asked Questions</h2></div>
          <ul class="st-faq">
            <li class="st-faq__item"><h3 class="st-faq__q">How do I record utang for a customer?</h3><p class="st-faq__a">Tap the + button, choose Record Utang, pick the customer, add the items and confirm. The customer&rsquo;s balance goes up right away.</p></li>
            <li class="st-faq__item"><h3 class="st-faq__q">How do I record a payment (bayad)?</h3><p class="st-faq__a">Tap the + button, choose Record Bayad, pick the customer, enter the amount and how they paid, then confirm. The balance goes down.</p></li>
            <li class="st-faq__item"><h3 class="st-faq__q">How do I add a customer?</h3><p class="st-faq__a">Open Customers and tap Add Customer. You only need a name. A phone number is optional, and the customer doesn&rsquo;t need a CrediTrack account.</p></li>
            <li class="st-faq__item"><h3 class="st-faq__q">How do customers join my store?</h3><p class="st-faq__a">Show them your Store QR Code or give them your Store Code. You can find both under Profile &amp; Settings, Store QR Code &amp; Store Code.</p></li>
            <li class="st-faq__item"><h3 class="st-faq__q">How do I change my store details?</h3><p class="st-faq__a">Go to Profile &amp; Settings, open Store Information and tap Edit. Your photo, name, email and contact number are under Edit Profile.</p></li>
            <li class="st-faq__item"><h3 class="st-faq__q">Why can&rsquo;t I see my customers&rsquo; accounts?</h3><p class="st-faq__a">A new store starts with no records. Records appear as you add customers and record utang or bayad.</p></li>
          </ul>
        </section>

        <section class="panel" aria-labelledby="contact-title" id="contact">
          <div class="panel__head"><h2 class="panel__title" id="contact-title">Contact Support</h2></div>
          <p class="st-intro">Can&rsquo;t find an answer? Send us a message and we&rsquo;ll get back to you.</p>
          @await Html.PartialAsync("/Pages/Shared/_ContactList.cshtml")
        </section>
      </div>
    </main>
  </div>

  <div class="toast" id="toast" role="status" aria-live="polite"></div>

@section Scripts {
  <script src="/js/session.js?v=5"></script>
  <script src="/js/api/http.js"></script>
  <script src="/js/api/owner-api.js"></script>
  <script src="/js/components/owner-shell.js"></script>
  <script src="/js/components/breadcrumbs.js"></script>
  <script src="/js/main.js"></script>
  <script src="/js/components/help-bot.js"></script>
}
