@{
    ViewData["Title"] = @"Profile &amp; Settings | CrediTrack";
    ViewData["Body"] = @"class=""owner"" data-root=""/"" data-page=""settings"" data-nav=""sub"" data-title=""Profile &amp; Settings"" data-back=""dashboard""";
}

@section Head {
  <meta name="description" content="Your profile and store information, password, notification preferences and app details.">
  <meta name="theme-color" content="#071A52">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/tokens.css?v=2">
  <link rel="stylesheet" href="/css/base.css?v=2">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/components/owner-shell.css?v=3">
  <link rel="stylesheet" href="/css/components/owner-ui.css?v=2">
  <!-- Shared owner page styles (page grid, heading, profile card, info list, form actions): same look as Customers -->
  <link rel="stylesheet" href="/css/pages/owner-customers.css">
  <link rel="stylesheet" href="/css/pages/owner-settings.css?v=3">
  <link rel="stylesheet" href="/css/components/breadcrumbs.css">
  <link rel="stylesheet" href="/css/glass.css?v=4">
  <link rel="stylesheet" href="/css/polish.css?v=1">
}

  <div class="owner-app">
    <!-- Back button and title are added here by js/components/owner-shell.js (no header, sidebar or bottom navigation, like Notifications) -->
    <main class="owner-main" id="main">
      <div class="page page--settings st-owner" id="page">

        <p class="text-muted st-lead">Manage your account and preferences.</p>

        <div class="st-stack">

          <!-- Profile: banner, centered photo, name, role and store, personal information, Edit Profile -->
          <section class="panel profile st-identity st-card" aria-labelledby="pf-name" aria-busy="true">
            <div class="st-card__banner" aria-hidden="true"></div>
            <div class="st-card__avatar">
              <span class="profile__avatar" id="pf-avatar" aria-hidden="true"></span>
              <a class="st-card__camera" href="profile-edit" data-route="owner-profile-edit" aria-label="Change profile photo"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8h3l1.5-2h7L17 8h3v11H4z"/><circle cx="12" cy="13" r="3.5"/></svg></a>
            </div>
            <div class="profile__main">
              <h2 class="profile__name" id="pf-name"></h2>
              <p class="st-card__role">Store Owner</p>
              <p class="st-card__store"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10l1.5-5h13L20 10M4 10v9h16v-9M4 10h16M10 19v-5h4v5"/></svg><span id="pf-store"></span></p>
              <p class="st-badges"><span class="badge badge--success"><span class="st-dot" aria-hidden="true"></span>Account Active</span></p>
            </div>

            <dl class="st-info" aria-label="Personal information">
              <div class="st-info__row"><span class="st-info__icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M5 20c.8-4 3.6-6 7-6s6.2 2 7 6"/></svg></span><div><dt>Full Name</dt><dd id="pf-fullName"></dd></div></div>
              <div class="st-info__row"><span class="st-info__icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3.5 7l8.5 6 8.5-6"/></svg></span><div><dt>Email Address</dt><dd id="pf-email"></dd></div></div>
              <div class="st-info__row"><span class="st-info__icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.5 3.5h3l1.5 4-2 1.5a11 11 0 0 0 6 6l1.5-2 4 1.5v3a2 2 0 0 1-2 2A16 16 0 0 1 4.5 5.5a2 2 0 0 1 2-2z"/></svg></span><div><dt>Contact Number</dt><dd id="pf-contactNumber"></dd></div></div>
            </dl>

            <a class="btn btn--primary btn--block profile__edit" href="profile-edit" data-route="owner-profile-edit" id="edit-open">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20h4L19 9a2.1 2.1 0 0 0-4-4L4 16z"/><path d="M13.5 6.5l4 4"/></svg>
              <span>Edit Profile</span>
            </a>
          </section>

          <section class="st-group" aria-labelledby="store-mgmt-title">
            <h2 class="st-heading" id="store-mgmt-title">Store Management</h2>
            <ul class="panel st-menu">
              <li><a class="st-menu__item" href="store-information" data-route="owner-store-info"><span class="st-menu__icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9l1.5-5h13L20 9"/><path d="M4 9a2.5 2.5 0 0 0 5 0 2.5 2.5 0 0 0 6 0 2.5 2.5 0 0 0 5 0"/><path d="M5 12v8h14v-8"/><path d="M10 20v-5h4v5"/></svg></span><span class="st-menu__text"><span class="st-menu__title">Store Information</span><span class="st-menu__desc">Name, address, contact number</span></span><svg class="st-menu__chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></a></li>
              <li><a class="st-menu__item" href="store-qr" data-route="owner-store-qr"><span class="st-menu__icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><path d="M14 14h3v3M21 14v.01M14 21h3M21 17v4"/></svg></span><span class="st-menu__text"><span class="st-menu__title">Store QR Code &amp; Store Code</span><span class="st-menu__desc">Help customers find your store</span></span><svg class="st-menu__chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></a></li>
            </ul>
          </section>

          <!-- Appearance: one row shows the current mode and opens the Light / Dark / Follow device choice in place (js/theme.js saves it on this device) -->
          <section class="st-group" aria-labelledby="appearance-title">
            <h2 class="st-heading" id="appearance-title">Appearance</h2>
            <div class="panel st-appearance st-appearance--row">
              <button class="st-menu__item st-appearance__toggle" type="button" id="appearance-toggle" data-st-toggle aria-expanded="false" aria-controls="appearance-panel">
                <span class="st-menu__icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a9 9 0 1 0 0 18c1.4 0 2-.9 2-1.8 0-1.2-1-1.6-1-2.7 0-1 .8-1.5 1.8-1.5H17a4 4 0 0 0 4-4C21 7 17 3 12 3z"/><circle cx="7.5" cy="11.5" r="1"/><circle cx="10.5" cy="7.5" r="1"/><circle cx="15" cy="8" r="1"/></svg></span>
                <span class="st-menu__text"><span class="st-menu__title">Appearance</span><span class="st-menu__desc">Light or dark mode</span></span>
                <span class="st-chip" id="appearance-current" aria-live="polite">Light</span>
                <svg class="st-menu__chev st-appearance__chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
              </button>
              <div class="st-appearance__panel" id="appearance-panel" hidden>
                <p class="st-appearance__desc">Choose how CrediTrack looks on this device. &quot;Follow device&quot; switches between light and dark with your phone or computer.</p>
                <div class="theme-picker" data-theme-picker aria-label="Appearance"></div>
              </div>
            </div>
            <div class="panel st-appearance st-appearance--row">
              <button class="st-menu__item st-appearance__toggle" type="button" id="textsize-toggle" data-st-toggle aria-expanded="false" aria-controls="textsize-panel">
                <span class="st-menu__icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 19l5-13 5 13M5 14h6"/><path d="M15 19l3-8 3 8M16.2 16h3.6"/></svg></span>
                <span class="st-menu__text"><span class="st-menu__title">Text Size</span><span class="st-menu__desc">Make the text smaller or bigger</span></span>
                <span class="st-chip" id="textsize-current" aria-live="polite">Default</span>
                <svg class="st-menu__chev st-appearance__chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
              </button>
              <div class="st-appearance__panel" id="textsize-panel" hidden>
                <p class="st-appearance__desc">Choose how big the text is on this device.</p>
                <div class="theme-picker theme-picker--4" data-textsize-picker aria-label="Text Size"></div>
              </div>
            </div>
          </section>

          <section class="st-group" aria-labelledby="account-title">
            <h2 class="st-heading" id="account-title">Account</h2>
            <ul class="panel st-menu">
              <li><a class="st-menu__item" href="security" data-route="owner-security"><span class="st-menu__icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7.5 3v5.5c0 4.6-3.1 8.2-7.5 9.5-4.4-1.3-7.5-4.9-7.5-9.5V6z"/><path d="M9 12l2.2 2.2L15.5 10"/></svg></span><span class="st-menu__text"><span class="st-menu__title">Account Security</span><span class="st-menu__desc">Keep your account safe and secure</span></span><svg class="st-menu__chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></a></li>
              <li><a class="st-menu__item" href="settings-notifications" data-route="owner-settings-notifications"><span class="st-menu__icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 16V11a6 6 0 0 1 12 0v5l1.5 2h-15z"/><path d="M10 21h4"/></svg></span><span class="st-menu__text"><span class="st-menu__title">Notifications</span><span class="st-menu__desc">Manage notification preferences</span></span><svg class="st-menu__chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></a></li>
            </ul>
          </section>

          <section class="st-group" aria-labelledby="support-title">
            <h2 class="st-heading" id="support-title">Support</h2>
            <ul class="panel st-menu">
              <li><a class="st-menu__item" href="help-support" data-route="owner-help"><span class="st-menu__icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M9.6 9.4a2.5 2.5 0 1 1 3.4 2.3c-.7.4-1 .9-1 1.6M12 17v.01"/></svg></span><span class="st-menu__text"><span class="st-menu__title">Help &amp; Support</span><span class="st-menu__desc">FAQs and contact support</span></span><svg class="st-menu__chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></a></li>
              <li><a class="st-menu__item" href="about" data-route="owner-about"><span class="st-menu__icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8v.01"/></svg></span><span class="st-menu__text"><span class="st-menu__title">About CrediTrack</span><span class="st-menu__desc">App version and information</span></span><svg class="st-menu__chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></a></li>
            </ul>
          </section>


          <!-- Log Out asks for confirmation first (error prevention); the dialog's own Log Out link does the real sign-out (data-logout) -->
          <button class="btn btn--block st-logout" type="button" id="logout-open" aria-haspopup="dialog">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg>
            <span>Log Out</span>
          </button>
        </div>
      </div>
    </main>
  </div>

  <!-- Log Out confirmation -->
  <dialog class="st-dialog" id="logout-dialog" aria-labelledby="logout-title" aria-describedby="logout-desc">
    <div class="st-dialog__body">
      <span class="st-dialog__icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg></span>
      <h2 class="st-dialog__title" id="logout-title">Log out of CrediTrack?</h2>
      <p class="st-dialog__text" id="logout-desc">You will need to sign in again to see your account.</p>
    </div>
    <div class="st-dialog__actions">
      <button class="btn btn--secondary" type="button" id="logout-cancel">Cancel</button>
      <a class="btn btn--danger" href="#" data-route="login" data-logout id="logout-confirm">Log Out</a>
    </div>
  </dialog>

  <div class="toast" id="toast" role="status" aria-live="polite"></div>

@section Scripts {
  <script src="/js/session.js?v=5"></script>
  <script src="/js/api/http.js"></script>
  <script src="/js/api/owner-api.js"></script>
  <script src="/js/components/owner-shell.js"></script>
  <script src="/js/components/breadcrumbs.js"></script>
  <script src="/js/main.js"></script>
  <script src="/js/pages/owner-settings.js"></script>
}
