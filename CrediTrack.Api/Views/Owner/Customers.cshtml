@{
    ViewData["Title"] = @"Customers | CrediTrack";
    ViewData["Body"] = @"class=""owner"" data-root=""/"" data-page=""customers""";
}

@section Head {
  <meta name="description" content="Your store's customers, their outstanding balances, and credit and payment history.">
  <meta name="theme-color" content="#071A52">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/tokens.css?v=2">
  <link rel="stylesheet" href="/css/base.css?v=2">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/components/owner-shell.css?v=3">
  <link rel="stylesheet" href="/css/components/owner-ui.css?v=2">
  <link rel="stylesheet" href="/css/components/record-utang.css">
  <link rel="stylesheet" href="/css/components/record-bayad.css">
  <link rel="stylesheet" href="/css/pages/owner-customers.css?v=3">
  <link rel="stylesheet" href="/css/components/pager.css">
  <link rel="stylesheet" href="/css/components/breadcrumbs.css">
  <link rel="stylesheet" href="/css/glass.css?v=4">
  <link rel="stylesheet" href="/css/polish.css?v=1">
}

  <div class="owner-app">
    <!-- Header, sidebar and bottom navigation are added here by js/components/owner-shell.js -->
    <main class="owner-main" id="main">
      <div class="page" id="page">


        <header class="page-head">
          <div class="page-head__text">
            <h1 id="page-title">Customers</h1>
            <p class="text-muted" id="page-sub">Manage your store&rsquo;s customers.</p>
          </div>
          <a class="btn btn--primary page-head__add" href="customer-form" id="add-open">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
            <span>Add Customer</span>
          </a>
        </header>


        <!-- Customers who asked to join with the store code: nobody becomes a customer until the owner approves -->
        <section class="panel jr-panel" id="jr-panel" aria-labelledby="jr-title" hidden>
          <h2 class="jr-title" id="jr-title">Join requests <span class="jr-count" id="jr-count"></span></h2>
          <p class="text-muted jr-sub">These people asked to join your store with your store code. Approve only people you know. Declined people are told no.</p>
          <p class="jr-hint" id="jr-attach-hint">If you already keep a record for someone, choose it under &ldquo;Already in your records?&rdquo; before you approve. The account is then attached to that record and keeps its utang and payments. Only do this when you are sure it is the same person: they will see everything in that record. Want people to join without waiting? Turn on Auto-approve in <a href="store-qr" data-route="owner-store-qr">Store QR Code &amp; Store Code</a>.</p>
          <ul class="jr-list" id="jr-list"></ul>
        </section>

        <section class="panel cust-panel" aria-labelledby="list-title">
          <h2 class="visually-hidden" id="list-title">Customer list</h2>

          <div class="toolbar" id="toolbar">
            <div class="seg" role="group" aria-label="Customer view">
              <button class="seg__btn" type="button" data-view="active" aria-pressed="true">Active <span id="count-active">0</span></button>
              <button class="seg__btn" type="button" data-view="archived" aria-pressed="false">Archived <span id="count-archived">0</span></button>
            </div>
            <div class="search">
              <svg class="search__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
              <input class="input search__input" id="search" type="search" placeholder="Search name, code or number" autocomplete="off" aria-label="Search customers" aria-controls="cust-list">
              <button class="search__clear" type="button" id="search-clear" aria-label="Clear search" hidden>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
              </button>
            </div>
            <div class="chips" id="chips" role="group" aria-label="Filter customers">
              <button class="chip" type="button" data-filter="all" aria-pressed="true">All <span id="count-all">0</span></button>
              <button class="chip" type="button" data-filter="debt" aria-pressed="false">With Debt <span id="count-debt">0</span></button>
              <button class="chip" type="button" data-filter="paid" aria-pressed="false">Fully Paid <span id="count-paid">0</span></button>
            </div>
          </div>

          <p class="result-line" id="result-line" aria-live="polite" hidden></p>
          <ul class="cust-list" id="cust-list" hidden></ul>
          <nav class="pager" id="pager" hidden></nav>

          <!-- Empty states (one is shown at a time) -->
          <div class="empty" id="empty-none" hidden>
            <span class="empty__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><path d="M16 4.6a3.5 3.5 0 0 1 0 6.8M18 14.2a6.5 6.5 0 0 1 3.5 5.8"/></svg></span>
            <h3 class="empty__title">No customers yet</h3>
            <p class="empty__text">Add your first customer to start recording credit and payments.</p>
            <a class="btn btn--primary" href="customer-form" id="empty-add">Add Customer</a>
          </div>
          <div class="empty" id="empty-archived" hidden>
            <span class="empty__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="4.5" rx="1"/><path d="M5 8.5V19a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8.5M10 12.5h4"/></svg></span>
            <h3 class="empty__title" id="archived-title">No archived customers</h3>
            <p class="empty__text" id="archived-text">Customers you archive are kept here with all their records, and can be restored anytime.</p>
          </div>
          <div class="empty" id="empty-found" hidden>
            <span class="empty__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg></span>
            <h3 class="empty__title" id="found-title">No customers found</h3>
            <p class="empty__text" id="found-text">Check the spelling or try a different name.</p>
            <button class="btn btn--secondary" type="button" id="found-reset">Show all customers</button>
          </div>
        </section>

      </div>
    </main>
  </div>

  <div class="toast" id="toast" role="status" aria-live="polite"></div>

@section Scripts {
  <script src="/js/session.js?v=5"></script>
  <script src="/js/api/list-query.js"></script>
  <script src="/js/api/http.js"></script>
  <script src="/js/api/owner-api.js"></script>
  <script src="/js/components/owner-shell.js"></script>
  <script src="/js/components/pager.js"></script>
  <script src="/js/components/breadcrumbs.js"></script>
  <script src="/js/main.js"></script>
  <script src="/js/components/record-utang.js"></script>
  <script src="/js/components/record-bayad.js"></script>
  <script src="/js/pages/owner-customers.js?v=2"></script>
}
