@{
    ViewData["Title"] = @"Transaction Details | CrediTrack";
    ViewData["Body"] = @"class=""owner customer"" data-root=""/"" data-page=""history""";
}

@section Head {
  <meta name="description" content="The full details of one credit or payment: ID, type, date, store, amount, status, items or payment information.">
  <meta name="theme-color" content="#071A52">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/tokens.css?v=2">
  <link rel="stylesheet" href="/css/base.css?v=2">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/components/owner-shell.css?v=3">
  <link rel="stylesheet" href="/css/components/owner-ui.css?v=2">
  <link rel="stylesheet" href="/css/components/customer-shell.css">
  <!-- Shared detail-page styles: page layout and info lists (owner-customers.css), header, amount and items (owner-transactions.css) -->
  <link rel="stylesheet" href="/css/pages/owner-customers.css">
  <link rel="stylesheet" href="/css/pages/owner-transactions.css">
  <link rel="stylesheet" href="/css/pages/customer-transaction-details.css?v=2">
  <link rel="stylesheet" href="/css/components/breadcrumbs.css">
  <link rel="stylesheet" href="/css/glass.css?v=4">
  <link rel="stylesheet" href="/css/polish.css?v=1">
}

  <div class="owner-app">
    <!-- Header, sidebar and bottom navigation are added here by js/components/customer-shell.js (History stays highlighted) -->
    <main class="owner-main" id="main">
      <div class="page page--narrow" id="page">

        <a class="btn btn--ghost cback cback--top" id="back-top" href="history">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
          <span>Back to History</span>
        </a>


        <!-- Shown when the link has no valid transaction -->
        <section class="panel" id="missing" hidden>
          <div class="empty">
            <span class="empty__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h14l-3.5-3.5M20 16H6l3.5 3.5"/></svg></span>
            <h2 class="empty__title">Transaction not found</h2>
            <p class="empty__text">This transaction may not exist, or the link is incorrect.</p>
          </div>
        </section>

        <div class="txd" id="detail" hidden>

          <section class="panel txd-head" aria-labelledby="txd-title">
            <span class="txd-head__icon" id="txd-icon" aria-hidden="true"></span>
            <div class="txd-head__main">
              <h1 class="txd-head__title" id="txd-title"></h1>
              <p class="txd-head__meta" id="txd-meta"></p>
            </div>
            <span class="badge" id="txd-status"></span>
          </section>

          <section class="panel txd-amount" aria-labelledby="amount-label">
            <p class="txd-amount__label" id="amount-label">Transaction Amount</p>
            <p class="txd-amount__value" id="txd-amount"></p>
            <p class="txd-amount__customer">Store: <strong id="txd-store"></strong></p>
          </section>

          <!-- Credit: purchased items -->
          <section class="panel" id="items-panel" aria-labelledby="items-title" hidden>
            <div class="panel__head"><h2 class="panel__title" id="items-title">Items Purchased</h2></div>
            <ul class="txd-items" id="txd-items"></ul>
            <p class="cnote" id="items-none" hidden>Item details were not recorded for this credit.</p>
            <p class="txd-total"><span>Total Amount</span><strong id="txd-total"></strong></p>
          </section>

          <!-- Payment: how it was paid -->
          <section class="panel" id="payment-panel" aria-labelledby="payment-title" hidden>
            <div class="panel__head"><h2 class="panel__title" id="payment-title">Payment Details</h2></div>
            <dl class="info__list" id="txd-payment"></dl>
          </section>

          <section class="panel" aria-labelledby="info-title">
            <div class="panel__head"><h2 class="panel__title" id="info-title">Transaction Information</h2></div>
            <dl class="info__list" id="txd-info"></dl>
          </section>

          <!-- Credit that still has a balance: go to Make a Payment with this store preselected -->
          <a class="btn btn--primary btn--block txd-pay" id="txd-pay" href="request-payment" hidden>Pay</a>

          <a class="btn btn--secondary btn--block cback" id="back-bottom" href="history">Back to History</a>

        </div>

      </div>
    </main>
  </div>

  <div class="toast" id="toast" role="status" aria-live="polite"></div>

@section Scripts {
  <script src="/js/session.js?v=5"></script>
  <script src="/js/api/http.js"></script>
  <script src="/js/api/customer-api.js"></script>
  <script src="/js/components/customer-shell.js"></script>
  <script src="/js/components/breadcrumbs.js"></script>
  <script src="/js/main.js?v=8"></script>
  <script src="/js/pages/customer-transaction-details.js"></script>
}
