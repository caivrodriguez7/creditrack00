@{
    ViewData["Title"] = @"Customer Code &amp; QR | CrediTrack";
    ViewData["Body"] = @"class=""owner customer"" data-root=""/"" data-page=""profile"" data-nav=""sub"" data-title=""Customer Code &amp; QR"" data-back=""profile""";
}

@section Head {
  <meta name="description" content="Your CrediTrack Customer Code and personal QR code. Show them to a store owner to identify your account.">
  <meta name="theme-color" content="#071A52">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/tokens.css?v=2">
  <link rel="stylesheet" href="/css/base.css?v=2">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/components/owner-shell.css?v=3">
  <link rel="stylesheet" href="/css/components/owner-ui.css?v=2">
  <link rel="stylesheet" href="/css/components/customer-shell.css">
  <!-- Shared with the Store Owner's Store QR Code & Store Code page: .st-qr (QR frame, code, View Larger), .st-steps, .form-note -->
  <link rel="stylesheet" href="/css/pages/owner-customers.css">
  <link rel="stylesheet" href="/css/pages/owner-settings.css">
  <link rel="stylesheet" href="/css/pages/customer-code.css">
  <link rel="stylesheet" href="/css/components/breadcrumbs.css">
  <link rel="stylesheet" href="/css/glass.css?v=4">
  <link rel="stylesheet" href="/css/polish.css?v=1">
}

  <div class="owner-app">
    <!-- Back button and title are added here by js/components/customer-shell.js -->
    <main class="owner-main" id="main">
      <div class="page page--settings page--settings-sub" id="page">


        <!-- Customer Code -->
        <section class="panel cc-card" aria-labelledby="cc-title">
          <div class="panel__head"><h2 class="panel__title" id="cc-title">Your Customer Code</h2></div>
          <p class="st-intro" id="cc-name"></p>
          <p class="st-qr__code cc-code" id="cc-code"></p>
          <p class="cc-hint">Your unique CrediTrack customer ID</p>
          <div class="form-actions">
            <button class="btn btn--secondary" type="button" id="cc-copy">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V6a2 2 0 0 1 2-2h9"/></svg>
              <span id="cc-copy-text">Copy Code</span>
            </button>
          </div>
        </section>

        <!-- Personal QR code (holds CREDITRACK:CUSTOMER:<the same customer code>) -->
        <section class="panel st-qr" aria-labelledby="qr-title">
          <div class="panel__head"><h2 class="panel__title" id="qr-title">My QR Code</h2></div>
          <p class="st-intro">This QR code holds the same Customer Code shown above.</p>
          <div class="st-qr__frame" id="qr-frame" role="img" aria-label="Your customer QR code"></div>
          <p class="cc-qr-code" id="qr-code" aria-hidden="true"></p>
          <button class="btn btn--ghost st-qr__zoom" type="button" id="qr-zoom" aria-pressed="false" aria-controls="qr-frame">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"/></svg>
            <span id="qr-zoom-text">View Larger</span>
          </button>
          <div class="form-actions">
            <button class="btn btn--primary" type="button" id="qr-download">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11M7 11l5 5 5-5M5 20h14"/></svg>
              <span>Download QR</span>
            </button>
          </div>
          <p class="field__hint" id="qr-status" role="status" aria-live="polite"></p>
        </section>

        <!-- Instructions -->
        <section class="panel" aria-labelledby="how-title">
          <div class="panel__head"><h2 class="panel__title" id="how-title">How to use your code and QR</h2></div>
          <ol class="st-steps">
            <li><strong>Identify yourself.</strong> Show your QR code to the store owner, or tell them your Customer Code. It points to your CrediTrack account only.</li>
            <li><strong>Link an existing record.</strong> If a store already keeps your utang record, choose <strong>I have an existing credit record</strong> when you join that store. The store owner uses your code or QR to find which account is yours, then links your record from <strong>Link Customer Account</strong>. They may also ask for a temporary linking code, which expires after a short time.</li>
            <li><strong>Keep it for people you trust.</strong> Share it only with a store you buy from. It cannot be used to log in, pay, or change a balance.</li>
          </ol>
          <p class="form-note cc-warn"><strong>Not a Store Code</strong>Your Customer Code starts with <b>CT-CUS-</b>. A Store Code (like STR-001) is what you enter to <i>join</i> a store, and a record number (like CUS-014) is how a store lists you in its own book. Do not use one in place of the other.</p>
        </section>

        <p class="cc-link"><a href="#" data-route="customer-profile">Back to Profile</a></p>
      </div>
    </main>
  </div>

  <div class="toast" id="toast" role="status" aria-live="polite"></div>

@section Scripts {
  <script src="/js/session.js?v=5"></script>
  <script src="/js/api/http.js"></script>
  <script src="/js/api/customer-api.js"></script>
  <script src="/js/components/customer-shell.js"></script>
  <script src="/js/components/breadcrumbs.js"></script>
  <script src="/js/main.js?v=8"></script>
  <script src="/js/vendor/qrcode.js"></script>
  <script src="/js/pages/customer-code.js"></script>
}
