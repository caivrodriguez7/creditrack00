@page "/register-customer"
@{
    ViewData["Title"] = @"Create Customer Account | CrediTrack";
    ViewData["Viewport"] = "width=device-width, initial-scale=1";
    ViewData["Body"] = @"class=""split-page auth auth--create auth--form auth--center"" data-root=""/""";
}

@section Head {
  <meta name="description" content="Create a CrediTrack customer account to view your utang, payments, and transactions.">
  <meta name="theme-color" content="#071A52">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/tokens.css?v=2">
  <link rel="stylesheet" href="/css/base.css?v=2">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/components/split-layout.css?v=4">
  <link rel="stylesheet" href="/css/pages/auth.css">
  <link rel="stylesheet" href="/css/pages/register.css">
  <link rel="stylesheet" href="/css/glass.css?v=4">
  <link rel="stylesheet" href="/css/polish.css?v=1">
}

  <main class="split">

    <aside class="split__brand" aria-label="About CrediTrack">
      <img class="logo-light brand__logo" src="/assets/images/creditrack-logo-transparent.png?v=3" width="1363" height="597"
           alt="CrediTrack logo. Every Credit, On Track.">
      <img class="logo-dark brand__logo" src="/assets/images/creditrack-logo-dark.png?v=3" width="1363" height="597"
           alt="" aria-hidden="true">
      <p class="brand__lead">A store credit management system for sari-sari stores and their customers.</p>
      <div class="brand__art">
        <svg viewBox="0 0 360 240" role="img" aria-label="Illustration of a sari-sari store with shelves of goods">
        <defs>
          <g id="shelf-row">
            <rect x="0" y="0" width="18" height="20" rx="3"/>
            <rect x="26" y="4" width="18" height="16" rx="3"/>
            <rect x="52" y="0" width="18" height="20" rx="3"/>
            <rect x="78" y="4" width="18" height="16" rx="3"/>
          </g>
        </defs>
        <rect x="0" y="222" width="360" height="6" rx="3" fill="#bfe3e1"/>
        <rect x="34" y="78" width="292" height="144" fill="#e1f4f3"/>
        <rect x="52" y="108" width="116" height="94" rx="6" fill="#ffffff" stroke="#b4dad8"/>
        <rect x="192" y="108" width="116" height="94" rx="6" fill="#ffffff" stroke="#b4dad8"/>
        <g fill="#F0F59A"><use href="#shelf-row" x="62" y="116"/></g>
        <g fill="#35A5A0"><use href="#shelf-row" x="62" y="146"/></g>
        <g fill="#086B70"><use href="#shelf-row" x="62" y="176" transform="translate(0 -2)"/></g>
        <g fill="#086B70"><use href="#shelf-row" x="202" y="116"/></g>
        <g fill="#071A52"><use href="#shelf-row" x="202" y="146"/></g>
        <g fill="#F0F59A"><use href="#shelf-row" x="202" y="176" transform="translate(0 -2)"/></g>
        <g fill="#b4dad8"><rect x="58" y="138" width="104" height="3"/><rect x="58" y="168" width="104" height="3"/><rect x="198" y="138" width="104" height="3"/><rect x="198" y="168" width="104" height="3"/></g>
        <g stroke="#b4dad8" stroke-width="1">
          <path fill="#071A52" d="M20 52h40v26a20 20 0 0 1-40 0z"/>
          <path fill="#fff" d="M60 52h40v26a20 20 0 0 1-40 0z"/>
          <path fill="#071A52" d="M100 52h40v26a20 20 0 0 1-40 0z"/>
          <path fill="#fff" d="M140 52h40v26a20 20 0 0 1-40 0z"/>
          <path fill="#071A52" d="M180 52h40v26a20 20 0 0 1-40 0z"/>
          <path fill="#fff" d="M220 52h40v26a20 20 0 0 1-40 0z"/>
          <path fill="#071A52" d="M260 52h40v26a20 20 0 0 1-40 0z"/>
          <path fill="#fff" d="M300 52h40v26a20 20 0 0 1-40 0z"/>
        </g>
        <rect x="90" y="8" width="180" height="34" rx="8" fill="#071A52"/>
        <text x="180" y="30" text-anchor="middle" font-size="14" font-weight="700" fill="#fff">SARI-SARI STORE</text>
      </svg>
      </div>
    </aside>

    <div class="split__main">
        <a class="auth__back" href="account-type" data-discard-draft aria-label="Back to account type">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          <span>Back</span>
        </a>


    <section class="auth__panel card" aria-labelledby="reg-title">
      <div class="auth__heading">
        <span class="badge">Customer</span>
        <h1 id="reg-title">Create your account</h1>
        <p class="text-muted">Two quick steps to get started.</p>
      </div>

      <div class="stepper" id="stepper" aria-label="Registration progress">
        <p class="stepper__status" id="stepper-status" aria-live="polite">Step 1 of 2 &middot; Personal Information</p>
        <ol class="stepper__bar stepper__bar--2">
          <li class="stepper__seg is-current" data-step-seg="1" aria-current="step"><span class="visually-hidden">Step 1: Personal Information</span></li>
          <li class="stepper__seg" data-step-seg="2"><span class="visually-hidden">Step 2: Account Security</span></li>
        </ol>
      </div>

      <form class="reg-form" id="register-customer-form" novalidate>
        <fieldset class="form-step" data-step="1">
          <legend class="form-step__title" tabindex="-1">Personal Information</legend>
          <p class="form-step__intro text-muted">Tell us who you are.</p>
        <div class="field">
          <label class="field__label" for="fullName">Full name</label>
          <input class="input" id="fullName" name="fullName" type="text" autocomplete="name" placeholder="e.g., Juan Dela Cruz" required aria-describedby="fullName-error">
          <p class="field__error" id="fullName-error" hidden></p>
        </div>
        <div class="field">
          <label class="field__label" for="contactNumber">Contact number</label>
          <input class="input" id="contactNumber" name="contactNumber" type="tel" autocomplete="tel" inputmode="tel" placeholder="09XX XXX XXXX" required aria-describedby="contactNumber-error">
          <p class="field__error" id="contactNumber-error" hidden></p>
        </div>
        </fieldset>

        <fieldset class="form-step" data-step="2" hidden>
          <legend class="form-step__title" tabindex="-1">Account Security</legend>
          <p class="form-step__intro text-muted">Set up how you will log in.</p>
        <div class="field">
          <label class="field__label" for="email">Email address</label>
          <input class="input" id="email" name="email" type="email" inputmode="email" autocomplete="email" autocapitalize="none" spellcheck="false" placeholder="you@@example.com" required aria-describedby="email-error">
          <p class="field__error" id="email-error" hidden></p>
        </div>
        <div class="field">
          <label class="field__label" for="password">Password</label>
          <div class="input-wrap">
            <input class="input input--toggle" id="password" name="password" type="password" autocomplete="new-password" placeholder="Create a password" required aria-describedby="password-rules password-error">
            <button class="input-wrap__toggle" type="button" data-toggle-password="password" aria-label="Show password" aria-pressed="false"><svg class="icon-eye" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg><svg class="icon-eye-off" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.6 5.1A10.6 10.6 0 0 1 12 5c6.4 0 10 7 10 7a17.6 17.6 0 0 1-3.2 4.2M6.4 6.4A17.4 17.4 0 0 0 2 12s3.6 7 10 7a10 10 0 0 0 4.6-1.1"/><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2M3 3l18 18"/></svg></button>
          </div>
          <ul class="pw-rules" id="password-rules" aria-label="Password requirements">
            <li data-rule="length">At least 8 characters</li>
            <li data-rule="upper">One uppercase letter (A-Z)</li>
            <li data-rule="lower">One lowercase letter (a-z)</li>
            <li data-rule="number">One number (0-9)</li>
            <li data-rule="special">One special character (e.g., ! @@ # $ %)</li>
          </ul>
          <p class="field__error" id="password-error" hidden></p>
        </div>
        <div class="field">
          <label class="field__label" for="confirmPassword">Confirm password</label>
          <div class="input-wrap">
            <input class="input input--toggle" id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" placeholder="Re-enter your password" required aria-describedby="confirmPassword-hint confirmPassword-error">
            <button class="input-wrap__toggle" type="button" data-toggle-password="confirmPassword" aria-label="Show password" aria-pressed="false"><svg class="icon-eye" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg><svg class="icon-eye-off" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.6 5.1A10.6 10.6 0 0 1 12 5c6.4 0 10 7 10 7a17.6 17.6 0 0 1-3.2 4.2M6.4 6.4A17.4 17.4 0 0 0 2 12s3.6 7 10 7a10 10 0 0 0 4.6-1.1"/><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2M3 3l18 18"/></svg></button>
          </div>
          <p class="field__hint" id="confirmPassword-hint">Must match your password.</p>
          <p class="field__error" id="confirmPassword-error" hidden></p>
        </div>


        <div class="field consent">
          <label class="consent__label" for="agreeTerms">
            <input class="consent__input" id="agreeTerms" name="agreeTerms" type="checkbox" required aria-describedby="agreeTerms-hint agreeTerms-error">
            <span>I have read and agree to the <a href="/terms?from=register-customer" data-legal>Terms and Conditions</a> and <a href="/privacy?from=register-customer" data-legal>Privacy Policy</a> of CrediTrack.</span>
          </label>
          <p class="field__hint" id="agreeTerms-hint">Required to create your account.</p>
          <p class="field__error" id="agreeTerms-error" role="alert" hidden></p>
        </div>
        </fieldset>

        <div class="reg-actions">
          <button class="btn btn--secondary btn--lg" type="button" id="btn-back" hidden>Back</button>
          <button class="btn btn--primary btn--lg" type="submit" id="btn-next">Continue</button>
        </div>
      </form>

      <p class="auth__switch">Already have an account? <a href="login" data-route="login" data-discard-draft>Log In</a></p>
    </section>
    </div>

  </main>

  <div class="toast" id="toast" role="status" aria-live="polite"></div>

@section Scripts {
  <script src="/js/api/http.js"></script>
  <script src="/js/session.js?v=5"></script>
  <script src="/js/session.js?v=5"></script>
  <script src="/js/api/customer-api.js"></script>
  <script src="/js/main.js"></script>
  <script src="/js/components/register-draft.js"></script>
  <script src="/js/pages/register-customer.js"></script>
}
