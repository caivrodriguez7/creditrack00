@page "/customer/history"
@{
    ViewData["Title"] = @"Transaction History | CrediTrack";
    ViewData["Body"] = @"class=""owner customer"" data-root=""/"" data-page=""history""";
}

@section Head {
  <meta name="description" content="All your credits and payments across the stores you have joined, with search, a store filter and tabs.">
  <meta name="theme-color" content="#071A52">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/tokens.css?v=2">
  <link rel="stylesheet" href="/css/base.css?v=2">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/components/owner-shell.css?v=3">
  <link rel="stylesheet" href="/css/components/owner-ui.css?v=2">
  <link rel="stylesheet" href="/css/components/customer-shell.css">
  <!-- Shared list-page styles (page heading, search box, result line): same look as the Store Owner lists -->
  <link rel="stylesheet" href="/css/pages/owner-customers.css">
  <link rel="stylesheet" href="/css/pages/customer-history.css">
  <link rel="stylesheet" href="/css/components/pager.css?v=4">
  <link rel="stylesheet" href="/css/components/breadcrumbs.css">
  <link rel="stylesheet" href="/css/glass.css?v=4">
  <link rel="stylesheet" href="/css/polish.css?v=1">
}

  <div class="owner-app">
    <!-- Header, sidebar and bottom navigation are added here by js/components/customer-shell.js -->
    <main class="owner-main" id="main">
      <div class="page chist" id="chist">

        <header class="page-head">
          <div class="page-head__text">
            <h1 id="page-title">Transaction History</h1>
            <p class="text-muted">All your store transactions in one place.</p>
          </div>
        </header>


        <section class="panel hpanel" aria-labelledby="list-title">
          <h2 class="visually-hidden" id="list-title">Transactions</h2>

          <div class="toolbar htoolbar" id="toolbar" hidden>
            <!-- 1. Search -->
            <div class="search">
              <svg class="search__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
              <input class="input search__input" id="search" type="search" placeholder="Search transactions" autocomplete="off" aria-label="Search transactions by description, store, method or amount" aria-controls="tx-list">
              <button class="search__clear" type="button" id="search-clear" aria-label="Clear search" hidden>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
              </button>
            </div>

            <!-- 2. Store filter (shown only when more than one store is connected) -->
            <div class="hpick" id="store-filter" hidden>
              <label class="hpick__label" for="store-select">Filter by store</label>
              <div class="hpick__box">
                <span class="hpick__icon" aria-hidden="true"></span>
                <select class="hpick__select" id="store-select"></select>
                <span class="hpick__chev" aria-hidden="true"></span>
              </div>
            </div>

            <!-- 3. Tabs: All, Credits, Payments -->
            <div class="htabs" role="tablist" aria-label="Transaction type" id="tabs">
              <button class="htab" type="button" role="tab" id="tab-all" data-tab="all" aria-selected="true" aria-controls="tx-panel" tabindex="0">All <span class="htab__count" id="count-all">0</span></button>
              <button class="htab" type="button" role="tab" id="tab-credit" data-tab="credit" aria-selected="false" aria-controls="tx-panel" tabindex="-1">Credits <span class="htab__count" id="count-credit">0</span></button>
              <button class="htab" type="button" role="tab" id="tab-payment" data-tab="payment" aria-selected="false" aria-controls="tx-panel" tabindex="-1">Payments <span class="htab__count" id="count-payment">0</span></button>
            </div>
          </div>

          <p class="result-line" id="result-line" aria-live="polite" hidden></p>

          <!-- 4. Transaction list (each row opens its Transaction Details) -->
          <div id="tx-panel" role="tabpanel" aria-labelledby="tab-all">
            <ul class="hlist" id="tx-list" hidden></ul>
          </div>
          <nav class="pager" id="pager" hidden></nav>

          <!-- Empty states (one is shown at a time) -->
          <div class="empty" id="empty-none" hidden>
            <span class="empty__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>
            <h3 class="empty__title" id="none-title">No transactions yet</h3>
            <p class="empty__text" id="none-text">Credits and payments recorded at your stores will show up here.</p>
            <a class="btn btn--primary hpanel__join" href="#" data-route="customer-join-store" id="none-join" hidden>Join a Store</a>
          </div>
          <div class="empty" id="empty-found" hidden>
            <span class="empty__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg></span>
            <h3 class="empty__title" id="found-title">No transactions found</h3>
            <p class="empty__text" id="found-text">Check the spelling or try different filters.</p>
            <button class="btn btn--secondary" type="button" id="found-reset">Clear filters</button>
          </div>
        </section>

      </div>
    </main>
  </div>

  <div class="toast" id="toast" role="status" aria-live="polite"></div>

@section Scripts {
  <script src="/js/session.js?v=5"></script>
  <script src="/js/api/http.js"></script>
  <script src="/js/api/customer-api.js"></script>
  <script src="/js/components/customer-shell.js"></script>
  <script src="/js/components/pager.js?v=4"></script>
  <script src="/js/components/breadcrumbs.js"></script>
  <script src="/js/main.js?v=8"></script>
  <script src="/js/pages/customer-history.js?v=p10"></script>
}
