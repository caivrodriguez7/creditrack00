@page "/customer/payment-request-details"
@{
    ViewData["Title"] = @"Payment Request Details | CrediTrack";
    ViewData["Body"] = @"class=""owner customer"" data-root=""/"" data-page=""payments""";
}

@section Head {
  <meta name="description" content="The details of one payment request: store, amount, method, reference number, proof of payment, your note, when it was submitted and its status.">
  <meta name="theme-color" content="#071A52">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/tokens.css?v=2">
  <link rel="stylesheet" href="/css/base.css?v=2">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/components/owner-shell.css?v=3">
  <link rel="stylesheet" href="/css/components/owner-ui.css?v=2">
  <link rel="stylesheet" href="/css/components/customer-shell.css">
  <!-- Shared detail-page styles: page layout and info lists (owner-customers.css), Back buttons (customer-transaction-details.css) -->
  <link rel="stylesheet" href="/css/pages/owner-customers.css">
  <link rel="stylesheet" href="/css/pages/customer-transaction-details.css">
  <link rel="stylesheet" href="/css/pages/customer-payments.css">
  <link rel="stylesheet" href="/css/pages/customer-payment-request-details.css">
  <link rel="stylesheet" href="/css/components/breadcrumbs.css">
  <link rel="stylesheet" href="/css/glass.css?v=4">
  <link rel="stylesheet" href="/css/polish.css?v=1">
}

  <div class="owner-app">
    <!-- Header, sidebar and bottom navigation are added here by js/components/customer-shell.js -->
    <main class="owner-main" id="main">
      <div class="page page--narrow" id="page">

        <a class="btn btn--ghost cback cback--top" id="back-top" href="payments">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
          <span>Back to Payments</span>
        </a>


        <!-- Shown when the link has no valid payment request -->
        <section class="panel" id="missing" hidden>
          <div class="empty">
            <span class="empty__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 3h7l4 4v13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z"/><path d="M9.5 13.5l2 2 3.5-4"/></svg></span>
            <h1 class="empty__title">Payment request not found</h1>
            <p class="empty__text">This payment request may not exist, or the link is incorrect.</p>
          </div>
        </section>

        <div class="prq" id="detail" hidden>

          <!-- Amount, store and current status -->
          <section class="panel prq-head" aria-labelledby="prq-title">
            <div class="prq-head__top">
              <h1 class="prq-head__label" id="prq-title">Payment Request</h1>
              <span class="pstatus" id="prq-status"></span>
            </div>
            <p class="prq-head__amount" id="prq-amount"></p>
            <p class="prq-head__store">to <strong id="prq-store"></strong></p>
          </section>

          <!-- What the status means: Pending (awaiting review), Completed (approval and confirmation), Rejected (the store's reason) -->
          <section class="panel prq-state" id="prq-state" aria-labelledby="prq-state-title">
            <h2 class="prq-state__title" id="prq-state-title"></h2>
            <p class="prq-state__text" id="prq-state-text"></p>
            <dl class="info__list prq-state__list" id="prq-state-list" hidden></dl>
          </section>

          <section class="panel" aria-labelledby="prq-details-title">
            <div class="panel__head"><h2 class="panel__title" id="prq-details-title">Payment Details</h2></div>
            <dl class="info__list" id="prq-details"></dl>
          </section>

          <section class="panel" aria-labelledby="prq-proof-title">
            <div class="panel__head"><h2 class="panel__title" id="prq-proof-title">Proof of Payment</h2></div>
            <div id="prq-proof"></div>
          </section>

          <section class="panel" id="prq-note-panel" aria-labelledby="prq-note-title" hidden>
            <div class="panel__head"><h2 class="panel__title" id="prq-note-title">Your Note</h2></div>
            <p class="prq-note" id="prq-note"></p>
          </section>

          <a class="btn btn--secondary btn--block cback" id="back-bottom" href="payments">Back to Payments</a>
        </div>

      </div>
    </main>
  </div>

  <!-- View Larger: the proof picture, full size -->
  <dialog class="prq-viewer" id="viewer" aria-label="Proof of payment, larger view">
    <div class="prq-viewer__bar">
      <p class="prq-viewer__title">Proof of Payment</p>
      <button class="btn btn--secondary prq-viewer__close" type="button" id="viewer-close">Close</button>
    </div>
    <div class="prq-viewer__stage"><img id="viewer-img" alt=""></div>
  </dialog>

  <div class="toast" id="toast" role="status" aria-live="polite"></div>

@section Scripts {
  <script src="/js/session.js?v=5"></script>
  <script src="/js/api/http.js"></script>
  <script src="/js/api/customer-api.js"></script>
  <script src="/js/components/customer-shell.js"></script>
  <script src="/js/components/breadcrumbs.js"></script>
  <script src="/js/main.js?v=8"></script>
  <script src="/js/pages/customer-payment-request-details.js"></script>
}
