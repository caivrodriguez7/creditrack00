@* Shared layout for every CrediTrack page. Each page sets its Title and the <body> attributes (ViewData["Body"]),
   adds its own stylesheets in the "Head" section and its scripts in the "Scripts" section.
   Theme (Light / Dark / Follow device): js/theme.js runs in the <head> before anything is painted, so the right colors
   show from the first frame. css/theme.css is loaded after the page's own styles so the dark colors win. *@
@{
    var bodyAttributes = ViewData["Body"] as string ?? "";
}
@* NOTE: <!body> (with the !) switches off the Razor "body" tag helper so @Html.Raw works in the attributes. Do not change it to <body>. *@
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="@(ViewData["Viewport"] ?? "width=device-width, initial-scale=1, viewport-fit=cover")">
  <meta name="color-scheme" content="light dark">
  <title>@Html.Raw(ViewData["Title"])</title>
  @await RenderSectionAsync("Head", required: false)
  <link rel="stylesheet" href="/css/theme.css?v=3">
  <script src="/js/theme.js?v=1"></script>
</head>
<!body @Html.Raw(bodyAttributes)>
  @RenderBody()
  @await RenderSectionAsync("Scripts", required: false)
  <script src="/js/components/theme-picker.js?v=2"></script>
  <script src="/js/language.js?v=2"></script>
</!body>
</html>
