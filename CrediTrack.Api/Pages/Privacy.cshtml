@page "/privacy"
@{
    var site = SiteOptions.Value;
    ViewData["Title"] = @"Privacy Policy | CrediTrack";
    ViewData["Body"] = @"class=""legal"" data-root=""/""";
}

@section Head {
  <meta name="description" content="Privacy Policy of CrediTrack, a store credit management system for sari-sari stores and their customers.">
  <meta name="theme-color" content="#ffffff">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/tokens.css?v=2">
  <link rel="stylesheet" href="/css/base.css?v=2">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/components/site-footer.css">
  <link rel="stylesheet" href="/css/pages/legal.css">
}

  <div class="legal__wrap">
    <header class="legal__top">
      <a class="legal__back" href="/welcome" aria-label="Go back">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        <span>Back</span>
      </a>
      <img class="logo-light legal__logo" src="/assets/images/creditrack-logo-transparent.png?v=3" width="1363" height="597" alt="CrediTrack logo">
      <img class="logo-dark legal__logo" src="/assets/images/creditrack-logo-dark.png?v=3" width="1363" height="597" alt="" aria-hidden="true">
    </header>

    <main class="legal__main" id="main">
      <article class="legal__doc card">
        <h1>Privacy Policy</h1>
        <p class="legal__meta">Last updated: @site.LastUpdated</p>
        <p>@site.OperatorName operates @site.SystemName. This policy explains what personal information we collect, why, who can see it and what your choices are. We handle personal information in line with the Data Privacy Act of 2012 (Republic Act No. 10173) of the Philippines.</p>

        <h2>1. Information we collect</h2>
        <ul>
          <li><strong>Account information:</strong> your full name, email address, contact number and password. Passwords are stored in a protected (hashed) form, never as plain text.</li>
          <li><strong>Store owners:</strong> store name, address, contact number and the customer records you enter (name, contact number, code).</li>
          <li><strong>Credit and payment records:</strong> credits, items, amounts, due dates, payments, payment methods, reference numbers, voids and the reasons for them.</li>
          <li><strong>Payment requests:</strong> the amount, method, reference number and any proof-of-payment picture a customer sends.</li>
          <li><strong>Technical information:</strong> a sign-in cookie that keeps you logged in, and basic logs needed to keep the system secure.</li>
        </ul>

        <h2>2. How we use it</h2>
        <ul>
          <li>To create and protect your account, and to verify your email address.</li>
          <li>To keep and show credit and payment records between a store and its customers.</li>
          <li>To send reminders and notifications, such as due and overdue credits and payment request decisions.</li>
          <li>To send account emails, such as email verification and password reset.</li>
          <li>To answer support requests and to keep the system secure.</li>
        </ul>
        <p>We do not sell your personal information.</p>

        <h2>3. Who can see it</h2>
        <ul>
          <li>A <strong>customer</strong> sees only their own records, in the stores they joined.</li>
          <li>A <strong>store owner</strong> sees the records of their own store and its customers, and does not see other stores.</li>
          <li>Our support staff may see information when needed to help with a request.</li>
          <li>We share information with others only when the law requires it, or with service providers that help us run the system (for example, sending emails), who may use it only for that purpose.</li>
        </ul>

        <h2>4. How long we keep it</h2>
        <p>We keep your information while your account is active and as long as needed for the records of the stores you deal with. Credit and payment history is kept so balances stay correct. When an account is closed, we delete or de-identify the information we no longer need, unless the law requires us to keep it.</p>

        <h2>5. How we protect it</h2>
        <p>We use hashed passwords, a protected sign-in cookie, rate limits on sign-in and registration, and access checks so that each person only reaches their own records. No system is completely secure, so please keep your password private and log out on shared devices.</p>

        <h2>6. Your rights</h2>
        <p>Under the Data Privacy Act you may ask to be informed about how your data is used, to see and get a copy of it, to correct it, to object to its use, and to ask for it to be blocked or deleted, and you may complain to the National Privacy Commission. You can correct your name, email and contact number yourself in Edit Profile. For anything else, contact us using the details below.</p>

        <h2>7. Children</h2>
        <p>@site.SystemName is meant for adults who deal with store credit. Please do not register if you are under 18 without the guidance of a parent or guardian.</p>

        <h2>8. Changes to this policy</h2>
        <p>We may update this policy. The date at the top shows when it was last changed. Please also read our <a href="/terms">Terms and Conditions</a>.</p>

        <h2>9. Contact</h2>
        <p>For privacy questions or requests, contact @site.OperatorName:</p>
        <p class="legal__contact">
          Email: <a href="mailto:@site.SupportEmail">@site.SupportEmail</a><br>
          Phone: <a href="tel:@site.PhoneHref">@site.SupportPhone</a><br>
          Hours: @site.SupportHours
          @if (!string.IsNullOrWhiteSpace(site.Address)) { <text><br>Address: @site.Address</text> }
        </p>
      </article>
    </main>

    @await Html.PartialAsync("_SiteFooter")
  </div>

  <div class="toast" id="toast" role="status" aria-live="polite"></div>

@section Scripts {
  <script src="/js/pages/legal-nav.js"></script>
}
