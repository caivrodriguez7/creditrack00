@page "/owner/notifications"
@{
    ViewData["Title"] = @"Notifications | CrediTrack";
    ViewData["Body"] = @"class=""owner"" data-root=""/"" data-page=""notifications"" data-nav=""sub"" data-title=""Notifications"" data-back=""dashboard""";
}

@section Head {
  <meta name="description" content="Payment requests, overdue accounts and other updates about your store.">
  <meta name="theme-color" content="#071A52">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/tokens.css?v=2">
  <link rel="stylesheet" href="/css/base.css?v=2">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/components/owner-shell.css?v=3">
  <link rel="stylesheet" href="/css/components/owner-ui.css?v=2">
  <!-- Shared list-page styles (page grid, filter chips): same look as Customers and Transactions -->
  <link rel="stylesheet" href="/css/pages/owner-customers.css">
  <link rel="stylesheet" href="/css/pages/owner-notifications.css">
  <link rel="stylesheet" href="/css/components/breadcrumbs.css">
  <link rel="stylesheet" href="/css/glass.css?v=4">
  <link rel="stylesheet" href="/css/polish.css?v=1">
}

  <div class="owner-app">
    <main class="owner-main" id="main">
      <div class="page page--notifications" id="page">
        <!-- The title (h1) is inserted here by owner-shell.js -->
        <p class="text-muted nt-sub" id="page-sub">Updates about your store.</p>


        <!-- All / Unread and Mark all as read -->
        <div class="nt-toolbar" id="toolbar" hidden>
          <div class="chips" role="group" aria-label="Show notifications" id="filter-chips">
            <button class="chip" type="button" data-filter="all" aria-pressed="true">All <span id="count-all">0</span></button>
            <button class="chip" type="button" data-filter="unread" aria-pressed="false">Unread <span id="count-unread">0</span></button>
          </div>
          <button class="btn btn--ghost nt-markall" type="button" id="mark-all">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 12.5l4.5 4.5 7-9M10.5 16.5l1 1 9-10.5"/></svg>
            <span>Mark all as read</span>
          </button>
        </div>

        <section class="panel nt-panel" aria-labelledby="list-title">
          <h2 class="visually-hidden" id="list-title">Notification list</h2>
          <div id="nt-groups" hidden></div>

          <!-- Empty state: no notifications at all -->
          <div class="empty" id="empty-none" hidden>
            <span class="empty__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9a6 6 0 0 1 12 0c0 6 2.5 7.5 2.5 7.5h-17S6 15 6 9z"/><path d="M10 20a2.2 2.2 0 0 0 4 0"/></svg></span>
            <h3 class="empty__title">No notifications yet</h3>
            <p class="empty__text">Payment requests, overdue accounts and other store updates will show up here.</p>
          </div>

          <!-- Empty state: Unread tab with everything already read -->
          <div class="empty" id="empty-unread" hidden>
            <span class="empty__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.7 2.7L16 9.5"/></svg></span>
            <h3 class="empty__title">You&rsquo;re all caught up</h3>
            <p class="empty__text">There are no unread notifications right now.</p>
            <button class="btn btn--secondary" type="button" id="show-all">View all notifications</button>
          </div>
        </section>

        <p class="visually-hidden" id="live" role="status" aria-live="polite"></p>
      </div>
    </main>
  </div>

  <div class="toast" id="toast" role="status" aria-live="polite"></div>

@section Scripts {
  <script src="/js/session.js?v=5"></script>
  <script src="/js/api/http.js"></script>
  <script src="/js/api/owner-api.js"></script>
  <script src="/js/components/owner-shell.js"></script>
  <script src="/js/components/breadcrumbs.js"></script>
  <script src="/js/main.js"></script>
  <script src="/js/pages/owner-notifications.js"></script>
}
