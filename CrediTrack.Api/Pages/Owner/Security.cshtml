@page "/owner/security"
@{
    ViewData["Title"] = @"Security | CrediTrack";
    ViewData["Body"] = @"class=""owner"" data-root=""/"" data-page=""settings"" data-nav=""sub"" data-title=""Security"" data-back=""settings""";
}

@section Head {
  <!-- A password reset link can open this page with ?token=...: never pass the address on to the font host -->
  <meta name="referrer" content="no-referrer">
  <meta name="description" content="Change your password and keep your account protected.">
  <meta name="theme-color" content="#071A52">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/tokens.css?v=2">
  <link rel="stylesheet" href="/css/base.css?v=2">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/components/owner-shell.css?v=3">
  <link rel="stylesheet" href="/css/components/owner-ui.css?v=2">
  <!-- Shared owner page styles (page grid, heading, profile card, info list, form actions): same look as Customers -->
  <link rel="stylesheet" href="/css/pages/owner-customers.css">
  <link rel="stylesheet" href="/css/pages/owner-settings.css">
  <link rel="stylesheet" href="/css/components/security-forgot.css">
  <link rel="stylesheet" href="/css/components/breadcrumbs.css">
  <link rel="stylesheet" href="/css/glass.css?v=4">
  <link rel="stylesheet" href="/css/polish.css?v=1">
}

  <div class="owner-app">
    <!-- Back button and title are added here by js/components/owner-shell.js -->
    <main class="owner-main" id="main">
      <div class="page page--settings page--settings-sub" id="page">

        <!-- Change Password (interface and basic validation only) -->
            <section class="panel" aria-labelledby="pw-title">
              <div class="panel__head"><h2 class="panel__title" id="pw-title">Change Password</h2></div>

              <p class="st-intro">Use a strong password that you don&rsquo;t use anywhere else.</p>
              <p class="pw-reset__msg" id="pw-reset-msg" role="status" aria-live="polite" tabindex="-1" hidden></p>

              <form class="form-panel st-pw-form" id="pw-form" novalidate>
                <div class="field">
                  <label class="field__label" for="pw-current">Current password</label>
                  <div class="input-wrap">
                    <input class="input input--toggle" id="pw-current" type="password" autocomplete="current-password" placeholder="Enter your current password" required aria-describedby="pw-current-error">
                    <button class="input-wrap__toggle" type="button" data-toggle-password="pw-current" aria-label="Show password" aria-pressed="false"><svg class="icon-eye" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg><svg class="icon-eye-off" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.6 5.1A10.6 10.6 0 0 1 12 5c6.4 0 10 7 10 7a17.6 17.6 0 0 1-3.2 4.2M6.4 6.4A17.4 17.4 0 0 0 2 12s3.6 7 10 7a10 10 0 0 0 4.6-1.1"/><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2M3 3l18 18"/></svg></button>
                  </div>
                  <p class="field__error" id="pw-current-error" hidden></p>
                  <p class="pw-forgot"><button type="button" class="pw-forgot__btn" id="pw-forgot">Forgot your current password?</button></p>
                  <p class="pw-forgot__msg" id="pw-forgot-msg" role="status" aria-live="polite" hidden></p>
                </div>

                <div class="field">
                  <label class="field__label" for="pw-new">New password</label>
                  <div class="input-wrap">
                    <input class="input input--toggle" id="pw-new" type="password" autocomplete="new-password" placeholder="Create a new password" required aria-describedby="pw-rules pw-new-error">
                    <button class="input-wrap__toggle" type="button" data-toggle-password="pw-new" aria-label="Show password" aria-pressed="false"><svg class="icon-eye" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg><svg class="icon-eye-off" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.6 5.1A10.6 10.6 0 0 1 12 5c6.4 0 10 7 10 7a17.6 17.6 0 0 1-3.2 4.2M6.4 6.4A17.4 17.4 0 0 0 2 12s3.6 7 10 7a10 10 0 0 0 4.6-1.1"/><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2M3 3l18 18"/></svg></button>
                  </div>
                  <ul class="pw-rules" id="pw-rules" aria-label="Password requirements">
                    <li data-rule="length">At least 8 characters</li>
                    <li data-rule="upper">One uppercase letter (A-Z)</li>
                    <li data-rule="lower">One lowercase letter (a-z)</li>
                    <li data-rule="number">One number (0-9)</li>
                    <li data-rule="special">One special character (e.g., ! @@ # $ %)</li>
                  </ul>
                  <p class="field__error" id="pw-new-error" hidden></p>
                </div>

                <div class="field">
                  <label class="field__label" for="pw-confirm">Confirm new password</label>
                  <div class="input-wrap">
                    <input class="input input--toggle" id="pw-confirm" type="password" autocomplete="new-password" placeholder="Re-enter your new password" required aria-describedby="pw-confirm-error">
                    <button class="input-wrap__toggle" type="button" data-toggle-password="pw-confirm" aria-label="Show password" aria-pressed="false"><svg class="icon-eye" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg><svg class="icon-eye-off" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.6 5.1A10.6 10.6 0 0 1 12 5c6.4 0 10 7 10 7a17.6 17.6 0 0 1-3.2 4.2M6.4 6.4A17.4 17.4 0 0 0 2 12s3.6 7 10 7a10 10 0 0 0 4.6-1.1"/><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2M3 3l18 18"/></svg></button>
                  </div>
                  <p class="field__error" id="pw-confirm-error" hidden></p>
                </div>


                <div class="form-actions">
                  <button class="btn btn--secondary" type="button" id="pw-cancel">Cancel</button>
                  <button class="btn btn--primary" type="submit" id="pw-save">Update Password</button>
                </div>
              </form>
            </section>

        <section class="panel" aria-labelledby="prot-title">
          <div class="panel__head"><h2 class="panel__title" id="prot-title">Account Protection</h2></div>
          <ul class="st-tips">
            <li>Use a password you don&rsquo;t use on any other app or website.</li>
            <li>Never share your password or verification codes with anyone, even someone who says they work for CrediTrack.</li>
            <li>Log out when you use CrediTrack on a shared or public device.</li>
            <li>If you think someone else has your password, change it right away.</li>
          </ul>
        </section>
      </div>
    </main>
  </div>

  <div class="toast" id="toast" role="status" aria-live="polite"></div>

@section Scripts {
  <script src="/js/session.js?v=5"></script>
  <script src="/js/api/http.js"></script>
  <script src="/js/api/owner-api.js"></script>
  <script src="/js/components/owner-shell.js"></script>
  <script src="/js/components/breadcrumbs.js"></script>
  <script src="/js/components/security-forgot.js"></script>
  <script src="/js/components/security-reset.js"></script>
  <script src="/js/main.js"></script>
  <script src="/js/pages/owner-security.js"></script>
}
