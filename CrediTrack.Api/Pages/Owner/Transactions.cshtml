@page "/owner/transactions"
@{
    ViewData["Title"] = @"Transaction History | CrediTrack";
    ViewData["Body"] = @"class=""owner"" data-root=""/"" data-page=""transactions""";
}

@section Head {
  <meta name="description" content="All credits and payments recorded for your store, with search and filters.">
  <meta name="theme-color" content="#071A52">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/tokens.css?v=2">
  <link rel="stylesheet" href="/css/base.css?v=2">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/components/owner-shell.css?v=3">
  <link rel="stylesheet" href="/css/components/owner-ui.css?v=2">
  <link rel="stylesheet" href="/css/components/record-utang.css?v=date2">
  <link rel="stylesheet" href="/css/components/record-bayad.css">
  <!-- Shared list-page styles (page heading, search, filter chips): same look as Customers -->
  <link rel="stylesheet" href="/css/pages/owner-customers.css?v=3">
  <link rel="stylesheet" href="/css/pages/owner-transactions.css?v=4">
  <link rel="stylesheet" href="/css/components/pager.css?v=2">
  <link rel="stylesheet" href="/css/components/breadcrumbs.css">
  <link rel="stylesheet" href="/css/glass.css?v=4">
  <link rel="stylesheet" href="/css/polish.css?v=1">
}

  <div class="owner-app">
    <!-- Header, sidebar and bottom navigation are added here by js/components/owner-shell.js -->
    <main class="owner-main" id="main">
      <div class="page" id="page">

        <header class="page-head">
          <div class="page-head__text">
            <h1 id="page-title">Transaction History</h1>
            <p class="text-muted" id="page-sub">Review all store credits and payments.</p>
          </div>
        </header>


        <!-- Totals for what is currently listed (changes with the search and filters) -->
        <section class="tx-summary" id="summary" aria-label="Totals for the transactions shown" hidden>
          <div class="tx-sum tx-sum--credit">
            <p class="tx-sum__label">Credits Recorded</p>
            <p class="tx-sum__amount" id="sum-credit">&#8369;0.00</p>
            <p class="tx-sum__note" id="sum-credit-note"></p>
          </div>
          <div class="tx-sum tx-sum--payment">
            <p class="tx-sum__label">Payments Received</p>
            <p class="tx-sum__amount" id="sum-payment">&#8369;0.00</p>
            <p class="tx-sum__note" id="sum-payment-note"></p>
          </div>
        </section>

        <section class="panel tx-panel" aria-labelledby="list-title">
          <h2 class="visually-hidden" id="list-title">Transactions</h2>

          <!-- Shown when opened from Customer Details (transactions?customerId=): only that customer's transactions are listed -->
          <div class="tx-customer" id="customer-filter" hidden>
            <span class="tx-customer__avatar" id="customer-filter-avatar" aria-hidden="true"></span>
            <div class="tx-customer__main">
              <p class="tx-customer__label">Showing transactions of</p>
              <p class="tx-customer__name" id="customer-filter-name"></p>
            </div>
            <div class="tx-customer__actions">
              <a class="tx-customer__btn" id="customer-filter-back" href="customer-details">Back to customer</a>
              <button class="tx-customer__btn tx-customer__btn--ghost" type="button" id="customer-filter-clear">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
                <span>Show all</span>
              </button>
            </div>
          </div>

          <div class="toolbar tx-toolbar" id="toolbar" hidden>
            <div class="search">
              <svg class="search__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
              <input class="input search__input" id="search" type="search" placeholder="Search by customer name" autocomplete="off" aria-label="Search transactions by customer name" aria-controls="tx-groups">
              <button class="search__clear" type="button" id="search-clear" aria-label="Clear search" hidden>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
              </button>
            </div>

            <div class="tx-filters">
              <div class="chips" role="group" aria-label="Filter by transaction type" id="type-chips">
                <button class="chip" type="button" data-type="all" aria-pressed="true">All</button>
                <button class="chip" type="button" data-type="credit" aria-pressed="false">Credits</button>
                <button class="chip" type="button" data-type="payment" aria-pressed="false">Payments</button>
              </div>
              <label class="tx-date">
                <span class="tx-date__label">Status</span>
                <select class="select tx-date__select" id="status">
                  <option value="all">All statuses</option>
                  <option value="unpaid">Unpaid</option>
                  <option value="partial">Partially paid</option>
                  <option value="paid">Paid</option>
                  <option value="confirmed">Confirmed</option>
                  <option value="voided">Voided</option>
                </select>
              </label>
              <label class="tx-date">
                <span class="tx-date__label">Date</span>
                <select class="select tx-date__select" id="range">
                  <option value="all">All time</option>
                  <option value="today">Today</option>
                  <option value="7">Last 7 days</option>
                  <option value="30">Last 30 days</option>
                  <option value="month">This month</option>
                  <option value="custom">Custom range&hellip;</option>
                </select>
              </label>
            </div>

            <div class="tx-custom" id="custom" hidden>
              <label class="field"><span class="field__label">From</span><input class="input" type="date" id="from"></label>
              <label class="field"><span class="field__label">To</span><input class="input" type="date" id="to"></label>
              <p class="field__error tx-custom__error" id="custom-error" role="alert" hidden>The start date must be on or before the end date.</p>
            </div>
          </div>

          <p class="result-line" id="result-line" aria-live="polite" hidden></p>
          <div id="tx-groups" hidden></div>
          <nav class="pager" id="pager" hidden></nav>

          <!-- Empty states (one is shown at a time) -->
          <div class="empty" id="empty-none" hidden>
            <span class="empty__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h14l-3.5-3.5M20 16H6l3.5 3.5"/></svg></span>
            <h3 class="empty__title">No transactions yet</h3>
            <p class="empty__text">Credits and payments you record will show up here.</p>
            <a class="btn btn--secondary" href="#" data-route="record-credit">Record Utang</a>
          </div>
          <div class="empty" id="empty-found" hidden>
            <span class="empty__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg></span>
            <h3 class="empty__title" id="found-title">No transactions found</h3>
            <p class="empty__text" id="found-text">Check the spelling or try different filters.</p>
            <button class="btn btn--secondary" type="button" id="found-reset">Clear filters</button>
          </div>
        </section>

      </div>
    </main>
  </div>

  <div class="toast" id="toast" role="status" aria-live="polite"></div>

@section Scripts {
  <script src="/js/session.js?v=5"></script>
  <script src="/js/api/list-query.js"></script>
  <script src="/js/api/http.js"></script>
  <script src="/js/api/owner-api.js"></script>
  <script src="/js/components/owner-shell.js"></script>
  <script src="/js/components/pager.js?v=2"></script>
  <script src="/js/components/breadcrumbs.js"></script>
  <script src="/js/main.js"></script>
  <script src="/js/components/record-utang.js"></script>
  <script src="/js/components/record-bayad.js"></script>
  <script src="/js/pages/owner-transactions.js?v=p12"></script>
}
