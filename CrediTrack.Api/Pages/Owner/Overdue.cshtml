@page "/owner/overdue"
@{
    ViewData["Title"] = @"Overdue Accounts | CrediTrack";
    ViewData["Body"] = @"class=""owner"" data-root=""/"" data-page=""dashboard"" data-nav=""sub"" data-title=""Overdue Accounts"" data-back=""dashboard""";
}

@section Head {
  <meta name="description" content="Customers whose unpaid balance is past the due date you agreed on.">
  <meta name="theme-color" content="#071A52">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/tokens.css?v=2">
  <link rel="stylesheet" href="/css/base.css?v=2">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/components/owner-shell.css?v=3">
  <link rel="stylesheet" href="/css/components/owner-ui.css?v=2">
  <!-- Shared list-page styles (page grid): same look as Customers and Transactions -->
  <link rel="stylesheet" href="/css/pages/owner-customers.css">
  <link rel="stylesheet" href="/css/pages/owner-overdue.css">
  <link rel="stylesheet" href="/css/components/pager.css?v=2">
  <link rel="stylesheet" href="/css/components/breadcrumbs.css">
  <link rel="stylesheet" href="/css/glass.css?v=4">
  <link rel="stylesheet" href="/css/polish.css?v=1">
}

  <div class="owner-app">
    <main class="owner-main" id="main">
      <div class="page page--overdue" id="page">
        <!-- The title (h1) is inserted here by owner-shell.js -->
        <p class="text-muted od-sub" id="page-sub">Customers with an unpaid balance past the due date you agreed on.</p>


        <!-- Totals -->
        <section class="od-summary" aria-label="Overdue summary">
          <div class="od-sum">
            <p class="od-sum__label">Overdue Accounts</p>
            <p class="od-sum__value" id="sum-count">0</p>
            <p class="od-sum__note" id="sum-count-note">Customers past their due date</p>
          </div>
          <div class="od-sum">
            <p class="od-sum__label">Total Overdue Balance</p>
            <p class="od-sum__value od-sum__value--money" id="sum-total">&#8369;0.00</p>
            <p class="od-sum__note">Unpaid and past due</p>
          </div>
        </section>

        <section class="panel od-panel" id="od-panel" aria-labelledby="list-title">
          <h2 class="visually-hidden" id="list-title">Overdue customers</h2>

          <!-- Search, filter and sort (shown only when there is at least one overdue account) -->
          <div class="od-tools" id="od-tools" hidden>
            <div class="search od-search">
              <svg class="search__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
              <input class="input search__input" id="od-search" type="search" placeholder="Search by name" autocomplete="off" aria-label="Search overdue accounts by customer name" aria-controls="od-list">
              <button class="search__clear" type="button" id="od-search-clear" aria-label="Clear search" hidden>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
              </button>
            </div>
            <!-- Phone: a compact button that opens the filter and sort panel. Wide screens: hidden, the panel is always shown. -->
            <button class="btn btn--secondary od-toggle" type="button" id="od-toggle" aria-expanded="false" aria-controls="od-extra">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4"/></svg>
              <span>Filter &amp; Sort</span>
              <span class="od-toggle__count" id="od-toggle-count" hidden>0</span>
            </button>
            <p class="od-active" id="od-active" hidden></p>
            <div class="od-extra" id="od-extra">
            <div class="od-sort">
              <label class="visually-hidden" for="od-sort">Sort overdue accounts</label>
              <select class="select" id="od-sort">
                <option value="amount-desc">Highest Overdue Amount</option>
                <option value="amount-asc">Lowest Overdue Amount</option>
                <option value="due-asc">Oldest Due Date</option>
                <option value="due-desc">Most Recent Due Date</option>
              </select>
            </div>
            <div class="chips od-chips" role="group" aria-label="Filter by days overdue">
              <button class="chip" type="button" data-range="all" aria-pressed="true">All Overdue Accounts <span id="cnt-all">0</span></button>
              <button class="chip" type="button" data-range="1-7" aria-pressed="false">1&ndash;7 Days <span id="cnt-1-7">0</span></button>
              <button class="chip" type="button" data-range="8-30" aria-pressed="false">8&ndash;30 Days <span id="cnt-8-30">0</span></button>
              <button class="chip" type="button" data-range="30+" aria-pressed="false">Over 30 Days <span id="cnt-30">0</span></button>
            </div>
            </div>
          </div>
          <p class="result-line" id="od-result" aria-live="polite" hidden></p>

          <!-- Loading (first load and every search / filter / sort / page change) -->
          <p class="od-loading" id="od-loading" role="status" aria-live="polite">Loading overdue accounts&hellip;</p>

          <!-- Column headings (wide screens only; each value also has its own label for screen readers) -->
          <div class="od-head" id="od-head" aria-hidden="true" hidden>
            <span>Customer</span><span>Outstanding Balance</span><span>Overdue Amount</span><span>Due Date</span><span>Days Overdue</span><span class="od-head__action">Action</span>
          </div>
          <ul class="od-list" id="od-list" aria-live="off" hidden></ul>
          <nav class="pager" id="pager" hidden></nav>

          <!-- Error state: the accounts could not be loaded (server down, signed out...). Try again repeats the same request. -->
          <div class="empty" id="empty-error" role="alert" hidden>
            <span class="empty__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7.5v5.5M12 16.5v.01"/></svg></span>
            <h3 class="empty__title">Couldn&rsquo;t load overdue accounts</h3>
            <p class="empty__text" id="error-text">Something went wrong. Please try again.</p>
            <button class="btn btn--secondary" type="button" id="error-retry">Try again</button>
          </div>

          <!-- Empty state -->
          <div class="empty" id="empty" hidden>
            <span class="empty__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.7 2.7L16 9.5"/></svg></span>
            <h3 class="empty__title" id="empty-title">No overdue accounts</h3>
            <p class="empty__text" id="empty-text">Customers with an unpaid balance past their agreed due date will appear here. Credits with no fixed due date are never counted as overdue.</p>
            <a class="btn btn--secondary" href="dashboard" id="empty-back">Go Back</a>
          </div>
          <!-- No result for the current search / filter -->
          <div class="empty" id="empty-found" hidden>
            <span class="empty__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg></span>
            <h3 class="empty__title" id="found-title">No matching overdue accounts</h3>
            <p class="empty__text" id="found-text">Try a different name or filter.</p>
            <button class="btn btn--secondary" type="button" id="found-reset">Clear search and filters</button>
          </div>
        </section>
      </div>
    </main>
  </div>

  <div class="toast" id="toast" role="status" aria-live="polite"></div>

@section Scripts {
  <script src="/js/session.js?v=5"></script>
  <script src="/js/api/list-query.js"></script>
  <script src="/js/api/http.js"></script>
  <script src="/js/api/owner-api.js"></script>
  <script src="/js/components/owner-shell.js"></script>
  <script src="/js/components/pager.js?v=2"></script>
  <script src="/js/components/breadcrumbs.js"></script>
  <script src="/js/main.js"></script>
  <script src="/js/pages/owner-overdue.js?v=p10"></script>
}
