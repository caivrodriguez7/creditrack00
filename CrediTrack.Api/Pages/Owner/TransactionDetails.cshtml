@page "/owner/transaction-details"
@{
    ViewData["Title"] = @"Transaction Details | CrediTrack";
    ViewData["Body"] = @"class=""owner"" data-root=""/"" data-page=""transactions"" data-nav=""sub"" data-title=""Transaction Details"" data-back=""transactions""";
}

@section Head {
  <meta name="description" content="The full details of one credit or payment: customer, items, amount, status and who recorded it.">
  <meta name="theme-color" content="#071A52">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/tokens.css?v=2">
  <link rel="stylesheet" href="/css/base.css?v=2">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/components/owner-shell.css?v=3">
  <link rel="stylesheet" href="/css/components/owner-ui.css?v=2">
  <link rel="stylesheet" href="/css/pages/owner-customers.css">
  <link rel="stylesheet" href="/css/pages/owner-transactions.css">
  <!-- The confirmation dialog look is shared with Edit Transaction; void-specific styles are in owner-transaction-void.css -->
  <link rel="stylesheet" href="/css/pages/owner-transaction-edit.css">
  <link rel="stylesheet" href="/css/pages/owner-transaction-void.css">
  <!-- Change History timeline -->
  <link rel="stylesheet" href="/css/pages/owner-transaction-history.css">
  <link rel="stylesheet" href="/css/components/breadcrumbs.css">
  <link rel="stylesheet" href="/css/glass.css?v=4">
  <link rel="stylesheet" href="/css/polish.css?v=1">
}

  <div class="owner-app">
    <main class="owner-main" id="main">
      <div class="page page--narrow" id="page">


        <!-- Shown when the link has no valid transaction -->
        <section class="panel" id="missing" hidden>
          <div class="empty">
            <span class="empty__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h14l-3.5-3.5M20 16H6l3.5 3.5"/></svg></span>
            <h2 class="empty__title">Transaction not found</h2>
            <p class="empty__text">This transaction may not exist, or the link is incorrect.</p>
            <a class="btn btn--primary" href="transactions" data-route="owner-transactions">Back to Transaction History</a>
          </div>
        </section>

        <div class="txd" id="detail" hidden>

          <!-- Shown only for a voided transaction: when, by whom, why, and what it did to the balance -->
          <section class="panel vtx-notice" id="void-notice" aria-labelledby="void-notice-title" tabindex="-1" hidden>
            <h2 class="vtx-notice__title" id="void-notice-title">This transaction has been voided</h2>
            <p class="vtx-notice__text" id="void-notice-text"></p>
            <dl class="info__list" id="void-info"></dl>
          </section>

          <section class="panel txd-head" aria-labelledby="txd-title">
            <span class="txd-head__icon" id="txd-icon" aria-hidden="true"></span>
            <div class="txd-head__main">
              <h2 class="txd-head__title" id="txd-title"></h2>
              <p class="txd-head__meta" id="txd-meta"></p>
            </div>
            <span class="badge" id="txd-status"></span>
          </section>

          <section class="panel txd-amount" aria-labelledby="amount-label">
            <p class="txd-amount__label" id="amount-label">Transaction Amount</p>
            <p class="txd-amount__value" id="txd-amount"></p>
            <p class="txd-amount__customer">Customer: <a id="txd-customer" href="customer-details"></a></p>
          </section>

          <!-- Credit: purchased items -->
          <section class="panel" id="items-panel" aria-labelledby="items-title" hidden>
            <div class="panel__head"><h2 class="panel__title" id="items-title">Items Purchased</h2></div>
            <ul class="txd-items" id="txd-items"></ul>
            <p class="txd-total"><span>Total</span><strong id="txd-total"></strong></p>
          </section>

          <!-- Payment: how it was paid -->
          <section class="panel" id="payment-panel" aria-labelledby="payment-title" hidden>
            <div class="panel__head"><h2 class="panel__title" id="payment-title">Payment Details</h2></div>
            <dl class="info__list" id="txd-payment"></dl>
          </section>

          <section class="panel" aria-labelledby="info-title">
            <div class="panel__head"><h2 class="panel__title" id="info-title">Transaction Information</h2></div>
            <dl class="info__list" id="txd-info"></dl>
          </section>

          <!-- Change History: every Edit and Void of this transaction, oldest first. js/pages/owner-transaction-details.js fills it from
               CrediTrackApi.getTransaction().history; entries are only ever added (owner-api.js: updateTransaction, voidTransaction). -->
          <section class="panel txh" id="history-panel" aria-labelledby="history-title">
            <div class="panel__head">
              <h2 class="panel__title" id="history-title">Change History</h2>
              <span class="txh__count" id="history-count" hidden></span>
            </div>
            <!-- Nothing has changed yet -->
            <div class="empty" id="history-empty" hidden>
              <span class="empty__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/><path d="M12 7v5l3 2"/></svg></span>
              <h3 class="empty__title">No changes yet</h3>
              <p class="empty__text">This transaction has not been edited or voided. Any change you make will be listed here.</p>
            </div>
            <ol class="txh__list" id="history-list" aria-label="Changes, oldest first" hidden></ol>
            <p class="txh__note" id="history-note" hidden>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 4.5-3.2 8-8 9-4.8-1-8-4.5-8-9V6l8-3z"/><path d="M9 12l2 2 4-4"/></svg>
              <span>The original transaction and its previous values are kept. Each change adds a new entry; earlier entries are never overwritten or deleted.</span>
            </p>
          </section>

          <!-- Opens Edit Transaction (transaction-edit?id=); the ID and type stay the same -->
          <a class="btn btn--primary btn--block" id="txd-edit" href="transaction-edit">Edit Transaction</a>
          <a class="btn btn--secondary btn--block" id="txd-view-customer" href="customer-details">View Customer</a>
          <!-- Opens the confirmation dialog. Hidden once the transaction is voided (it cannot be voided twice) -->
          <button class="btn btn--block vtx-open" type="button" id="txd-void" aria-haspopup="dialog">Void Transaction</button>

        </div>

      </div>
    </main>
  </div>

  <!-- Confirmation before anything is voided -->
  <div class="etx-confirm" id="v-confirm" hidden>
    <div class="etx-confirm__backdrop" data-void-close></div>
    <div class="etx-confirm__card" role="alertdialog" aria-modal="true" aria-labelledby="v-title" aria-describedby="v-text" tabindex="-1">
      <h2 class="etx-confirm__title" id="v-title">Void this transaction?</h2>
      <p class="etx-confirm__text" id="v-text">This transaction will be marked as voided. It will not be permanently deleted: the original record stays in your history for reference.</p>
      <dl class="etx-confirm__rows" id="v-rows"></dl>
      <p class="field__error etx-error" id="v-blocked" role="alert" hidden></p>

      <form class="vtx-form" id="v-form" novalidate>
        <fieldset class="vtx-reasons" id="v-reasons" aria-describedby="v-reason-error">
          <legend class="vtx-label">Reason for voiding <span class="vtx-req">(required)</span></legend>
          <label class="vtx-radio"><input type="radio" name="v-reason" value="duplicate"><span>Duplicate transaction</span></label>
          <label class="vtx-radio"><input type="radio" name="v-reason" value="incorrect"><span>Incorrect entry</span></label>
          <label class="vtx-radio"><input type="radio" name="v-reason" value="other"><span>Other</span></label>
        </fieldset>
        <p class="field__error" id="v-reason-error" role="alert" hidden></p>

        <div class="field" id="v-remarks-field" hidden>
          <label class="vtx-label" for="v-remarks">Additional remarks <span class="vtx-req">(required)</span></label>
          <textarea class="textarea" id="v-remarks" rows="3" maxlength="200" placeholder="Tell us why this transaction is being voided" aria-describedby="v-remarks-error v-remarks-count"></textarea>
          <div class="etx-count"><p class="field__error" id="v-remarks-error" role="alert" hidden></p><span class="field__hint" id="v-remarks-count">0 / 200</span></div>
        </div>

        <p class="field__error etx-error" id="v-error" role="alert" hidden></p>
      </form>

      <div class="etx-confirm__actions">
        <button class="btn btn--secondary" type="button" id="v-cancel" data-void-close>Cancel</button>
        <button class="btn btn--danger" type="button" id="v-confirm-btn">Void Transaction</button>
      </div>
    </div>
  </div>

  <div class="toast" id="toast" role="status" aria-live="polite"></div>

@section Scripts {
  <script src="/js/session.js?v=5"></script>
  <script src="/js/api/http.js"></script>
  <script src="/js/api/owner-api.js?v=5"></script>
  <script src="/js/components/owner-shell.js"></script>
  <script src="/js/components/breadcrumbs.js"></script>
  <script src="/js/main.js"></script>
  <script src="/js/pages/owner-transaction-details.js?v=3"></script>
}
