@page "/account-type"
@{
    ViewData["Title"] = @"Choose Account Type | CrediTrack";
    ViewData["Viewport"] = "width=device-width, initial-scale=1";
    ViewData["Body"] = @"class=""split-page auth auth--create"" data-root=""/""";
}

@section Head {
  <meta name="description" content="Choose whether you are a store owner or a customer to get started with CrediTrack.">
  <meta name="theme-color" content="#071A52">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/tokens.css?v=2">
  <link rel="stylesheet" href="/css/base.css?v=2">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/components/split-layout.css?v=4">
  <link rel="stylesheet" href="/css/pages/auth.css">
  <link rel="stylesheet" href="/css/glass.css?v=4">
  <link rel="stylesheet" href="/css/polish.css?v=1">
}

  <main class="split">

    <aside class="split__brand" aria-label="About CrediTrack">
      <img class="logo-light brand__logo" src="/assets/images/creditrack-logo-transparent.png?v=3" width="1363" height="597"
           alt="CrediTrack logo. Every Credit, On Track.">
      <img class="logo-dark brand__logo" src="/assets/images/creditrack-logo-dark.png?v=3" width="1363" height="597"
           alt="" aria-hidden="true">
      <p class="brand__lead">A store credit management system for sari-sari stores and their customers.</p>
      <div class="brand__art">
        <svg viewBox="0 0 360 240" role="img" aria-label="Illustration of a sari-sari store with shelves of goods">
        <defs>
          <g id="shelf-row">
            <rect x="0" y="0" width="18" height="20" rx="3"/>
            <rect x="26" y="4" width="18" height="16" rx="3"/>
            <rect x="52" y="0" width="18" height="20" rx="3"/>
            <rect x="78" y="4" width="18" height="16" rx="3"/>
          </g>
        </defs>
        <rect x="0" y="222" width="360" height="6" rx="3" fill="#bfe3e1"/>
        <rect x="34" y="78" width="292" height="144" fill="#e1f4f3"/>
        <rect x="52" y="108" width="116" height="94" rx="6" fill="#ffffff" stroke="#b4dad8"/>
        <rect x="192" y="108" width="116" height="94" rx="6" fill="#ffffff" stroke="#b4dad8"/>
        <g fill="#F0F59A"><use href="#shelf-row" x="62" y="116"/></g>
        <g fill="#35A5A0"><use href="#shelf-row" x="62" y="146"/></g>
        <g fill="#086B70"><use href="#shelf-row" x="62" y="176" transform="translate(0 -2)"/></g>
        <g fill="#086B70"><use href="#shelf-row" x="202" y="116"/></g>
        <g fill="#071A52"><use href="#shelf-row" x="202" y="146"/></g>
        <g fill="#F0F59A"><use href="#shelf-row" x="202" y="176" transform="translate(0 -2)"/></g>
        <g fill="#b4dad8"><rect x="58" y="138" width="104" height="3"/><rect x="58" y="168" width="104" height="3"/><rect x="198" y="138" width="104" height="3"/><rect x="198" y="168" width="104" height="3"/></g>
        <g stroke="#b4dad8" stroke-width="1">
          <path fill="#071A52" d="M20 52h40v26a20 20 0 0 1-40 0z"/>
          <path fill="#fff" d="M60 52h40v26a20 20 0 0 1-40 0z"/>
          <path fill="#071A52" d="M100 52h40v26a20 20 0 0 1-40 0z"/>
          <path fill="#fff" d="M140 52h40v26a20 20 0 0 1-40 0z"/>
          <path fill="#071A52" d="M180 52h40v26a20 20 0 0 1-40 0z"/>
          <path fill="#fff" d="M220 52h40v26a20 20 0 0 1-40 0z"/>
          <path fill="#071A52" d="M260 52h40v26a20 20 0 0 1-40 0z"/>
          <path fill="#fff" d="M300 52h40v26a20 20 0 0 1-40 0z"/>
        </g>
        <rect x="90" y="8" width="180" height="34" rx="8" fill="#071A52"/>
        <text x="180" y="30" text-anchor="middle" font-size="14" font-weight="700" fill="#fff">SARI-SARI STORE</text>
      </svg>
      </div>
    </aside>

    <div class="split__main">
        <a class="auth__back" href="welcome" aria-label="Back to welcome page">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          <span>Back</span>
        </a>


    <section class="auth__panel card" aria-labelledby="type-title">
      <div class="auth__heading">
        <h1 id="type-title">Create an account</h1>
        <p class="text-muted">Choose the type of account you want to create.</p>
      </div>

      <form id="type-form" novalidate>
        <fieldset class="choice-group">
          <legend class="visually-hidden">Account type</legend>

          <label class="choice">
            <input class="choice__input" type="radio" name="account-type" value="store-owner">
            <span class="choice__icon choice__icon--owner" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9.5 4.6 4h14.8L21 9.5"/><path d="M3 9.5a3 3 0 0 0 6 0 3 3 0 0 0 6 0 3 3 0 0 0 6 0"/><path d="M5 12.5V20h14v-7.5"/><path d="M10 20v-4.5h4V20"/></svg>
            </span>
            <span class="choice__body">
              <span class="choice__title">Store Owner</span>
              <span class="choice__text">Manage your customers, credit transactions, payments, and reports.</span>
            </span>
            <span class="choice__check" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>
            </span>
          </label>

          <label class="choice choice--customer">
            <input class="choice__input" type="radio" name="account-type" value="customer">
            <span class="choice__icon choice__icon--customer" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4.5 20.5a7.5 7.5 0 0 1 15 0"/></svg>
            </span>
            <span class="choice__body">
              <span class="choice__title">Customer</span>
              <span class="choice__text">Link your stores, view your credit records, and submit payment details.</span>
            </span>
            <span class="choice__check" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>
            </span>
          </label>
        </fieldset>

        <p class="field__error choice-error" id="type-error" role="alert" hidden>Please choose an account type to continue.</p>

        <button class="btn btn--primary btn--block btn--lg" type="submit">Create an Account</button>
      </form>

      <div class="auth__divider"><span>Already have an account?</span></div>
      <a class="btn btn--secondary btn--block" href="#" data-route="login">Log In</a>
    </section>
    </div>

  </main>

  <div class="toast" id="toast" role="status" aria-live="polite"></div>

@section Scripts {
  <script src="/js/main.js"></script>
  <script src="/js/pages/account-type.js"></script>
}
